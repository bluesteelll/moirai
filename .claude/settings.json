{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(cargo xtask gate)",
      "Bash(cargo xtask gate --branch *)",
      "Bash(cargo xtask gate --ci)",
      "Bash(cargo xtask gate --list)",
      "Bash(cargo xtask worktree *)",
      "Bash(cargo fmt -p *)",
      "Bash(cargo clippy --locked -p *)",
      "Bash(MOIRAI_TEST_TIER=pr cargo test --locked -p *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git merge-base *)",
      "Bash(git worktree *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git push origin master)",
      "Workflow"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout .)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch --force*)",
      "Bash(git switch * --force*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch * --force*)",
      "Bash(git merge --abort*)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(* --no-verify)",
      "Bash(* --no-verify *)",
      "Bash(* -c core.hooksPath=*)"
    ]
  }
