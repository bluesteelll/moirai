0a                                          # elem: the element type byte
02                                          # n = 2
37 5c 61 ac 06 e3 8d 63 ea 83 d4 5a 15 a0 c1 07  # elements
2e 99 62 2a 49 94 1d 57 29 88 e6 3e 35 50 8f a9
9b 0b e9 5d f3 7b 6f 6c e6 d2 08 ab 5b db 59 64
c7 23 37 96 eb f6 00 91 40 b3 46 87 4d 7f d9 8b

# set {sha1 D, sha256 D256} of oid
