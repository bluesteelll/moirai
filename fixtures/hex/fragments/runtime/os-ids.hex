  0b d7 49 56 79 85 82 08 f8 6c 59 52 e7 6b 39 fa  # id
  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00  # parent
  {u32 0}                                   # aux
  {u32 0}                                   # docid
# kind 3 linux_ino: id = u64le(ino 1234567) || hgen cc14c0fded56631d, parent in the same encoding: OsFileId kind 3 `linux_ino` (57 B, [F11 §12.1])
  03                                        # kind
  bb a0 71 e6 d5 94 73 74 40 3e 0f b7 04 a8 ec ab  # vol_key
  87 d6 12 00 00 00 00 00 cc 14 c0 fd ed 56 63 1d  # id
  02 00 00 00 00 00 00 00 68 04 64 81 ca b9 2a 3d  # parent
  {u32 0}                                   # aux
  {u32 0}                                   # docid
# kind 4 darwin_fileid: u64le(fileid) || 8 zero bytes; docid 77 (owner decision #21 (d)): OsFileId kind 4 `darwin_fileid` (57 B, [F11 §12.1])
  04                                        # kind
  be b5 4c 01 e6 d7 5b f5 f4 a0 6c 2a b4 0c bb c4  # vol_key
  3f b4 96 00 00 00 00 00 00 00 00 00 00 00 00 00  # id
  16 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00  # parent
  {u32 0}                                   # aux
  {u32 77}                                  # docid

# VolumeCaps
# a ReFS-like volume: case-insensitive by default, ctime_on_rename known and set, id_locate by-id, journal usn, rename_noreplace native, ids_persistent; id_kind 2, btime tunneled-not-copied: VolumeCaps (16 B, [F11 §12.3])
  {u32 4793}                                # flags
  02                                        # id_kind
  01                                        # btime
  01                                        # case_rule
  00                                        # cloud
  {u64 100}                                 # mtime_granularity_ns
# a case-sensitive Linux volume: id_locate frontier, rename_noreplace native, ids_persistent; id_kind 3, btime unforgeable, case_rule 0 sensitive, 1 ns granularity: VolumeCaps (16 B, [F11 §12.3])
  {u32 4672}                                # flags
  03                                        # id_kind
  02                                        # btime
  00                                        # case_rule
  00                                        # cloud
  {u64 1}                                   # mtime_granularity_ns
