  39 fd 23 b3 5a 0f 04 12 de 26 91 bd 3d 90 3c ad  # id
  da 8f f3 25 49 fd d6 1f de ad 78 79 f2 73 c8 5b  # parent
  {u32 0}                                   # aux
  {u32 0}                                   # docid
