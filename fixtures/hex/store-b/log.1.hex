# fixtures/hex/store-b/log.1.hex: extent 1 of store B's log ([F05]), E = 65,536. Store B's project root uses
# sha256 (HEAD.project_oid_algo 2). Groups: the epoch-start group; init; commits b1-b6 (b2 on lane/x, created and
# deleted around it); then the rotation pad: the next group (commit b7, 60,213 bytes) does not fit the rest of this
# extent, so one lazy Noop group pads it to its last byte ([F05 §4.4] G-3) and b7 opens log.2 after its extent head.
# The pad's trailer is the chain value at lsn 65,536, which log.2's ExtentHead carries as chain_in.

# === group g1 at lsn 0: the epoch-start group (durable)
g1:
# --- record g1.r1: kind 28 `ExtentHead` at lsn 0 (group_end)
g1.r1:
  # RecHdr (32 B, [F05 §3.1])
  {len g1.r1..g1.r1.end}                    # len: header, payload and chain trailer
  1c                                        # kind 28 ExtentHead
  02                                        # flags: lazy=0, group_end=1, symdefs=0
  {u16 0}                                   # _reserved
  {u64 0}                                   # lsn = the record's own position
  {u64 0x2718281828459045}                  # epoch
  {xxh3_64 g1.r1..g1.r1+24 g1.r1+32..g1.r1.pl}  # xxh3_64: header [0,24) and payload ([F05 §3.4])
  # payload
g1.r1.p:
    {u64 0}                                 # epoch_lsn
    {xxh3_64 4590452818281827}              # chain_in = XXH3-64(epoch) (the epoch seed)
    # init: InitParams (32 B, [F04 §4.4])
      {u64 65536}                           # log_extent_bytes
      {u32 4}                               # hist_frame_commits
      {u32 4096}                            # hist_frame_bytes
      57 01 de 00 00 00 00 00 00 00 00 00 00 00 00 02  # store_id
    02                                      # project_oid_algo
    00                                      # hflags (bit 0 quiet, bit 1 readonly)
    {u64 0}                                 # commit_seq
    {u32 1}                                 # next_id
    {u32 1}                                 # next_anchor
    {u64 0}                                 # fence
    {u32 1}                                 # next_file_no
    {u32 0}                                 # next_ref_id
    {u64 0}                                 # hlc_seq
    {u64 0}                                 # hlc_commit
g1.r1.pl:
g1.tr:
{xxh3_64 g1..g1.tr seed={xxh3_64 4590452818281827}}  # chain trailer: XXH3-64 over the group's bytes before the trailer, seeded with the chain value at the group's first byte
g1.end:
g1.r1.end:

