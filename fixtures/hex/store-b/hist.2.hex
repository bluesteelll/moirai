# fixtures/hex/store-b/hist.2.hex: a hist file ([F10 §4]) holding extent 1 of store B's log: every
# record but the rotation pad, byte for byte, cut into frames of at most 4 commits and 4,096 raw bytes; b6's
# record (above 4,096 bytes) is a split frame of 4,096-byte blocks. Codec 0 throughout.

# SegHdr (120 B, [F09 §2.1])
seghdr:
  "MSEG"                                    # magic
  {u16 1}                                   # format
  02                                        # seg_kind 2 `hist`
