  {len 0..end u64}                          # total_len
  {blake3_256 data..end}                    # seg_digest: BLAKE3-256 over [data_off, total_len)
  {xxh3_64 table..data}                     # table_xxh3 over the section table
  {xxh3_64 0..112}                          # hdr_xxh3 over [0, 112)
# section table (3 entries of 32 B, [F09 §2.2])
