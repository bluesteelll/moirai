  {u64 1824}                                # seq_ring[5].lsn
  {u64 6}                                   # seq_ring[6].seq
  {u64 2065}                                # seq_ring[6].lsn
  {u64 7}                                   # seq_ring[7].seq
  {u64 65674}                               # seq_ring[7].lsn
  00*16                                     # seq_ring[8]: empty
  00*16                                     # seq_ring[9]: empty
  00*16                                     # seq_ring[10]: empty
  00*16                                     # seq_ring[11]: empty
  00*16                                     # seq_ring[12]: empty
