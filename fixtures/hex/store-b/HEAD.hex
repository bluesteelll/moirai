# fixtures/hex/store-b/HEAD.hex: store B's HEAD after log.2: active_log 2 (extent 1 retired; its history is in
# hist.5 after the gc rewrite), checkpoint_lsn in extent 2, the main set {seg.d3}, project_oid_algo 2 (sha256),
# the boot_id of a Linux boot. Both slots hold the same state after a durable publish (slot_seq 8 and 9).

# HeadSlot `slotA`: slot_seq 8 ([F04 §3])
slotA:
  "MOIR"                                    # magic
  {u16 1}                                   # format
  {u16 0}                                   # flags: quiet=0, fts_tier2=0, readonly=0, retired=0
  {u64 8}                                   # slot_seq
  {u64 0x2718281828459045}                  # epoch
  {u64 126537}                              # committed_lsn
  {u64 126537}                              # durable_lsn
  9b 7a 72 f8 2d 09 6e 88 ef 80 d4 9c 7b 73 ce 08  # boot_id
  {u32 0}                                   # config_gen
  {u64 126270}                              # checkpoint_lsn
  {u64 7}                                   # commit_seq
  {u32 10}                                  # next_id
  {u32 1}                                   # next_anchor
  {u64 1}                                   # fence
  {u32 2}                                   # active_log
  01                                        # n_segments
  00 00 00                                  # _pad0
  # segments: [8]SegRef (29 B each)
  {u32 3}                                   # segments[0].file_no
  02                                        # segments[0].kind (delta)
  {u64 126270}                              # segments[0].upto_lsn
  a3 c3 5d 4f e9 73 ab 0d 49 be c4 50 35 ec 18 40  # segments[0].blake3_16
  00*29                                     # segments[1]: empty
  00*29                                     # segments[2]: empty
  00*29                                     # segments[3]: empty
  00*29                                     # segments[4]: empty
  00*29                                     # segments[5]: empty
  00*29                                     # segments[6]: empty
  00*29                                     # segments[7]: empty
  {u64 1218}                                # refs_lsn
  {u64 0}                                   # pins_lsn
  {u64 0}                                   # heads_lsn
  {u64 0}                                   # markers_lsn
  # image_cursor: [4]ImageCursor (10 B each)
  00*10                                     # image_cursor[0]: empty
  00*10                                     # image_cursor[1]: empty
  00*10                                     # image_cursor[2]: empty
  00*10                                     # image_cursor[3]: empty
  # seq_ring: [32]SeqRingEntry (16 B each), entry k holds the commit with seq mod 32 = k
  00*16                                     # seq_ring[0]: empty
  {u64 1}                                   # seq_ring[1].seq
  {u64 387}                                 # seq_ring[1].lsn
  {u64 2}                                   # seq_ring[2].seq
  {u64 862}                                 # seq_ring[2].lsn
  {u64 3}                                   # seq_ring[3].seq
  {u64 1346}                                # seq_ring[3].lsn
