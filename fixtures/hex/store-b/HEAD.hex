  00*16                                     # seq_ring[29]: empty
  00*16                                     # seq_ring[30]: empty
  00*16                                     # seq_ring[31]: empty
  00*108                                    # _reserved0
  # init: InitParams (32 B, [F04 §4.4])
    {u64 65536}                             # log_extent_bytes
    {u32 4}                                 # hist_frame_commits
    {u32 4096}                              # hist_frame_bytes
    57 01 de 00 00 00 00 00 00 00 00 00 00 00 00 02  # store_id
  {u64 0}                                   # epoch_lsn
  {u32 6}                                   # next_file_no
  {u32 2}                                   # next_ref_id
  02                                        # project_oid_algo
  00 00 00 00 00 00 00                      # _pad1
  {u64 0x1a0c460e6c00000}                   # hlc_seq
  {u64 0x1a0c460bfb00000}                   # hlc_commit
