# fixtures/hex/codec/blobs.2.hex: a blobs file ([F10 §5]) sealed under HOLE(F10-blob-codec)'s expected candidate
# 2 `lz4-dict` with dict_no = 1 (fixtures/hex/codec/dict.1.hex): two bodies whose payloads are LZ4 blocks with the
# dictionary as preceding history (the first body's matches reach into the dictionary), one short body whose LZ4
# output is not shorter than its raw bytes (codec 0, [F10 §3.4]), and a fingerprint blob (class 2, always codec 0,
# [F10 §5.3]). A compressed payload's hash is a literal-operand directive over its raw bytes, so the raw bytes are
# in the file as data the assembler checks. LZ4 payloads are opaque at M0 ([PLAN §6.2] R3).

# SegHdr (120 B, [F09 §2.1])
seghdr:
  "MSEG"                                    # magic
  {u16 1}                                   # format
  06                                        # seg_kind 6 `blobs`
  00                                        # tok_ver
  {u32 4}                                   # n_rows
  {u16 2}                                   # n_sections
  {u16 0}                                   # _reserved
  {u32 2}                                   # file_no
  {u32 0}                                   # ref_id
  {u32 1}                                   # dict_no
  {u32 0}                                   # _reserved
  {u64 0}                                   # base_seq
  {u64 0}                                   # from_lsn
  {u64 0}                                   # upto_lsn
  {u64 0}                                   # rt_upto_lsn
  {len 0..end u64}                          # total_len
  {blake3_256 data..end}                    # seg_digest: BLAKE3-256 over [data_off, total_len)
  {xxh3_64 table..data}                     # table_xxh3 over the section table
  {xxh3_64 0..112}                          # hdr_xxh3 over [0, 112)
# section table (2 entries of 32 B, [F09 §2.2])
table:
  # SecEnt BLOBIDX (0x0310)
  {u16 784}                                 # tag
  {u16 0}                                   # flags
  {u32 4}                                   # count
  {len 0..s_0310 u64}                       # off (absolute)
  {len s_0310..s_0310.e u64}                # len
  {xxh3_64 s_0310..s_0310.e}                # xxh3
  # SecEnt BLOBDATA (0x0311)
  {u16 785}                                 # tag
  {u16 0}                                   # flags
  {u32 4}                                   # count
  {len 0..s_0311 u64}                       # off (absolute)
  {len s_0311..s_0311.e u64}                # len
  {xxh3_64 s_0311..s_0311.e}                # xxh3
data:

# === section BLOBIDX (0x0310)
s_0310:
  {u32 4}                                   # n
  {u32 36}                                  # row_w
  # row 0
    {blake3_128 536f616b20706c616e20666f7220746865206c6f636b2074696d656f75743a0a2d205b205d20726572756e2074686520736f616b207769746820313620777269 746572730a2d205b205d20726572756e2074686520736f616b207769746820333220777269746572730a2d205b205d20726572756e2074686520736f616b2077 69746820363420777269746572730a2d205b785d206d6561737572652074686520666c757368207039390a576169746572732072657472792065766572792035 206d7320666f72206174206d6f7374203220732e0a}  # hash: BLAKE3-128 of the raw bytes, given as literal operands
