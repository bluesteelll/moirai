    {u32 213}                               # raw_len
  # row 1
    {blake3_128 fprint.d..fprint.e}         # hash: BLAKE3-128 of the raw bytes
    02                                      # class 2 (fingerprint)
    00 00 00                                # _reserved
    {len 0..fprint u64}                     # off: absolute offset of the BlobEnc payload
    {len fprint..fprint.e}                  # len: the payload, codec byte included
