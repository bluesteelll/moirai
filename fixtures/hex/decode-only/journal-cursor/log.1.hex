      {u64 65536}                           # log_extent_bytes
      {u32 4}                               # hist_frame_commits
      {u32 4096}                            # hist_frame_bytes
      57 01 de 00 00 00 00 00 00 00 00 00 00 00 00 07  # store_id
    01                                      # project_oid_algo
    00                                      # hflags (bit 0 quiet, bit 1 readonly)
    {u64 0}                                 # commit_seq
    {u32 1}                                 # next_id
    {u32 1}                                 # next_anchor
    {u64 0}                                 # fence
    {u32 1}                                 # next_file_no
    {u32 0}                                 # next_ref_id
    {u64 0}                                 # hlc_seq
    {u64 0}                                 # hlc_commit
g1.r1.pl:
g1.tr:
{xxh3_64 g1..g1.tr seed={xxh3_64 df9b5713e0ac6824}}  # chain trailer: XXH3-64 over the group's bytes before the trailer, seeded with the chain value at the group's first byte
g1.end:
g1.r1.end:

