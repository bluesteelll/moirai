# fixtures/hex/store-f/blobs.3.hex: the blobs file ([F10 §5]) that the purge's delta checkpoint (log.2 g10,
# [F16] P-101 step 2) sealed with seg.d2: #2's body H2 only, class 1, codec 0. It seals no body of the dropped
# set: H1 (dropped by log.1 g7) and H3 (the import's drop, g6) are absent ([F10 §5.4] "Dropped bodies").

# SegHdr (120 B, [F09 §2.1])
seghdr:
  "KSEG"                                     # magic
  {u16 1}                                    # format
  06                                         # seg_kind 6 `blobs`
  00                                         # tok_ver
  {u32 1}                                    # n_rows
  {u16 2}                                    # n_sections
  {u16 0}                                    # _reserved
  {u32 3}                                    # file_no
  {u32 0}                                    # ref_id
  {u32 0}                                    # dict_no
  {u32 0}                                    # _reserved
  {u64 0}                                    # base_seq
  {u64 0}                                    # from_lsn
  {u64 0}                                    # upto_lsn
  {u64 0}                                    # rt_upto_lsn
  {len 0..end u64}                           # total_len
  {blake3_256 data..end}                     # seg_digest: BLAKE3-256 over [data_off, total_len)
  {xxh3_64 table..data}                      # table_xxh3 over the section table
  {xxh3_64 0..112}                           # hdr_xxh3 over [0, 112)
# section table (2 entries of 32 B, [F09 §2.2])
table:
  # SecEnt BLOBIDX (0x0310)
  {u16 784}                                  # tag
  {u16 0}                                    # flags
  {u32 1}                                    # count
  {len 0..s_0310 u64}                        # off (absolute)
  {len s_0310..s_0310.e u64}                 # len
  {xxh3_64 s_0310..s_0310.e}                 # xxh3
  # SecEnt BLOBDATA (0x0311)
  {u16 785}                                  # tag
  {u16 0}                                    # flags
  {u32 1}                                    # count
  {len 0..s_0311 u64}                        # off (absolute)
  {len s_0311..s_0311.e u64}                 # len
  {xxh3_64 s_0311..s_0311.e}                 # xxh3
data:

# === section BLOBIDX (0x0310)
s_0310:
  {u32 1}                                    # n
  {u32 36}                                   # row_w
  # row 0
    {blake3_128 body_h2.d..body_h2.e}          # hash: BLAKE3-128 of the raw bytes (H2)
    01                                         # class 1 (body)
    00 00 00                                   # _reserved
    {len 0..body_h2 u64}                       # off: absolute offset of the BlobEnc payload
    {len body_h2..body_h2.e}                   # len: the payload, codec byte included
    {u32 108}                                  # raw_len
s_0310.e:
{align 8}                                  # sections start at multiples of 8 ([F09 §2.2] P-2)

# === section BLOBDATA (0x0311)
s_0311:
  # BlobEnc `body_h2` ([F10 §3.2])
body_h2:
  00                                         # codec 0 `none`
body_h2.d:
  "Synthetic body of note #2 in store F: an ordinary paragraph that the owner drops as private after the purge."  # raw bytes (H2, #2's body)
body_h2.e:
s_0311.e:
end:
