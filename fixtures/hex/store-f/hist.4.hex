# fixtures/hex/store-f/hist.4.hex: the hist file ([F10 §4]) that holds extent 1 of store F's log, written
# by the purge ([F16] P-101 step 6) for the retirement of log.2 g11 (step 7): every record but the pad, in
# lsn order, the ExtentHead first, in one frame (2 commits, 1892 raw bytes, codec 0). f1 is kept without
# #1's body entry, whose hash H1 is in the dropped set of the retirement's scanned log ([F10 §4.1], spec sync
# 3, S3-R-8): n_bodies 1, RecHdr.len and RecHdr.xxh3_64 recomputed, RecHdr.lsn kept; [F10 §9]: "a Commit record
# without some of its body entries is valid". f2 keeps its cs_ref (cs.1 holds no live BlobRef of the purge set
# and names no replaced file). Both BodyDrop records are kept. The last record held is g7's BodyDrop, so
# upto_lsn is its end, 2018; the shortened f1 is not the last record. Every other record is a literal copy of
# log.1.bin; HCIDX indexes f1 and f2.

# SegHdr (120 B, [F09 §2.1])
seghdr:
  "KSEG"                                     # magic
  {u16 1}                                    # format
  02                                         # seg_kind 2 `hist`
  00                                         # tok_ver
  {u32 2}                                    # n_rows
  {u16 3}                                    # n_sections
  {u16 0}                                    # _reserved
  {u32 4}                                    # file_no
  {u32 0}                                    # ref_id
  {u32 0}                                    # dict_no
  {u32 0}                                    # _reserved
  {u64 2}                                    # base_seq
  {u64 0}                                    # from_lsn
  {u64 2018}                                 # upto_lsn
  {u64 0}                                    # rt_upto_lsn
  {len 0..end u64}                           # total_len
  {blake3_256 data..end}                     # seg_digest: BLAKE3-256 over [data_off, total_len)
  {xxh3_64 table..data}                      # table_xxh3 over the section table
  {xxh3_64 0..112}                           # hdr_xxh3 over [0, 112)
# section table (3 entries of 32 B, [F09 §2.2])
table:
  # SecEnt HFRAMES (0x0300)
  {u16 768}                                  # tag
  {u16 0}                                    # flags
  {u32 1}                                    # count
  {len 0..s_0300 u64}                        # off (absolute)
  {len s_0300..s_0300.e u64}                 # len
  {xxh3_64 s_0300..s_0300.e}                 # xxh3
  # SecEnt HCIDX (0x0301)
  {u16 769}                                  # tag
  {u16 0}                                    # flags
  {u32 2}                                    # count
  {len 0..s_0301 u64}                        # off (absolute)
  {len s_0301..s_0301.e u64}                 # len
  {xxh3_64 s_0301..s_0301.e}                 # xxh3
  # SecEnt HDATA (0x0302)
  {u16 770}                                  # tag
  {u16 0}                                    # flags
  {u32 1}                                    # count
  {len 0..s_0302 u64}                        # off (absolute)
  {len s_0302..s_0302.e u64}                 # len
  {xxh3_64 s_0302..s_0302.e}                 # xxh3
data:

# === section HFRAMES (0x0300)
s_0300:
  {u32 1}                                    # n
  {u32 88}                                   # row_w
  # row 0: the one frame
    {u64 0}                                    # first_lsn
    {u64 1884}                                 # last_lsn
    {u64 1}                                    # first_seq
    {u64 2}                                    # last_seq
    {u64 0x1a0c45156600000}                    # first_append_hlc
    {u64 0x1a0c45415800001}                    # last_append_hlc
    {len 0..fr0 u64}                           # off: absolute offset of the frame's block table
    {len fr0..fr0.e}                           # stored_len
    {u32 1892}                                 # raw_len
    {u32 12}                                   # n_records
    {u32 2}                                    # n_commits
    {u16 1}                                    # n_blocks
    00                                         # codec 0 `none`
    00                                         # _reserved
    {u32 0}                                    # _reserved
    {xxh3_64 fr0.d..fr0.e}                     # raw_xxh3: XXH3-64 of the frame's raw bytes
s_0300.e:
{align 8}                                  # sections start at multiples of 8 ([F09 §2.2] P-2)

