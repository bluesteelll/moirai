  # payload
g9.r1.p:
    {u64 0}                                    # epoch_lsn
    c0 f5 82 04 75 aa 59 d7                    # chain_in: the trailer of log.1's pad
    # init: InitParams (32 B, [F04 §4.4])
      {u64 65536}                                # log_extent_bytes
      {u32 4}                                    # hist_frame_commits
      {u32 4096}                                 # hist_frame_bytes
      57 01 de 00 00 00 00 00 00 00 00 00 00 00 00 08  # store_id
    01                                         # project_oid_algo (1 sha1: the store has no repository, [CFG §7.6])
    00                                         # hflags (bit 0 quiet, bit 1 readonly)
    {u64 2}                                    # commit_seq
    {u32 4}                                    # next_id
    {u32 1}                                    # next_anchor
    {u64 0}                                    # fence
    {u32 2}                                    # next_file_no
    {u32 2}                                    # next_ref_id
    {u64 0x1a0c454ffe00000}                    # hlc_seq
    {u64 0x1a0c45156600000}                    # hlc_commit
g9.r1.pl:
g9.tr:
{xxh3_64 g9..g9.tr seed=0xd759aa750482f5c0}  # chain trailer: XXH3-64 over the group's bytes before the trailer, seeded with the chain value at the group's first byte
g9.end:
g9.r1.end:

