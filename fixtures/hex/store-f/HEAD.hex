# fixtures/hex/store-f/HEAD.hex: store F's HEAD after log.2 g12's publish: active_log 2 (extent 1 retired
# into hist.4), checkpoint_lsn 65674, the main set {seg.d2}, commit_seq 2, next_id 4 (the Reserve's #3),
# next_file_no 5, hlc_seq = g12's BodyDrop hlc (a kind-29 record raises the HLC sequence, [F05 §10.2]),
# hlc_commit = f1's hlc, the boot_id of a Linux boot. Both slots hold the same state after a durable publish
# (slot_seq 10 and 11).

# HeadSlot `slotA`: slot_seq 10 ([F04 §3])
slotA:
  "KLTH"                                     # magic
  {u16 1}                                    # format
  {u16 0}                                    # flags: quiet=0, fts_tier2=0, readonly=0, retired=0
  {u64 10}                                   # slot_seq
  {u64 0x3c6ef372fe94f82b}                   # epoch
  {u64 66029}                                # committed_lsn
  {u64 66029}                                # durable_lsn
  05 00 2c 7c a5 4a 02 0c 87 dd dc 2b be a2 c0 30  # boot_id (Linux, as store B)
  {u32 0}                                    # config_gen
  {u64 65674}                                # checkpoint_lsn
  {u64 2}                                    # commit_seq
  {u32 4}                                    # next_id
  {u32 1}                                    # next_anchor
  {u64 0}                                    # fence
  {u32 2}                                    # active_log
  01                                         # n_segments
  00 00 00                                   # _pad0
  # segments: [8]SegRef (29 B each)
  {u32 2}                                    # segments[0].file_no
  02                                         # segments[0].kind (delta)
  {u64 65674}                                # segments[0].upto_lsn
  3e fc 84 6b d5 58 e3 87 a9 75 bf 0c 26 07 bd 04  # segments[0].blake3_16
  00*29                                      # segments[1]: empty
  00*29                                      # segments[2]: empty
  00*29                                      # segments[3]: empty
  00*29                                      # segments[4]: empty
  00*29                                      # segments[5]: empty
  00*29                                      # segments[6]: empty
  00*29                                      # segments[7]: empty
  {u64 1408}                                 # refs_lsn
  {u64 0}                                    # pins_lsn
  {u64 0}                                    # heads_lsn
  {u64 0}                                    # markers_lsn
  # image_cursor: [4]ImageCursor (10 B each)
  00*10                                      # image_cursor[0]: empty
  00*10                                      # image_cursor[1]: empty
  00*10                                      # image_cursor[2]: empty
  00*10                                      # image_cursor[3]: empty
  # seq_ring: [32]SeqRingEntry (16 B each), entry k holds the commit with seq mod 32 = k
  00*16                                      # seq_ring[0]: empty
  {u64 1}                                    # seq_ring[1].seq
  {u64 387}                                  # seq_ring[1].lsn
  {u64 2}                                    # seq_ring[2].seq
  {u64 1670}                                 # seq_ring[2].lsn
  00*16                                      # seq_ring[3]: empty
  00*16                                      # seq_ring[4]: empty
  00*16                                      # seq_ring[5]: empty
  00*16                                      # seq_ring[6]: empty
  00*16                                      # seq_ring[7]: empty
  00*16                                      # seq_ring[8]: empty
  00*16                                      # seq_ring[9]: empty
  00*16                                      # seq_ring[10]: empty
  00*16                                      # seq_ring[11]: empty
  00*16                                      # seq_ring[12]: empty
  00*16                                      # seq_ring[13]: empty
  00*16                                      # seq_ring[14]: empty
  00*16                                      # seq_ring[15]: empty
  00*16                                      # seq_ring[16]: empty
  00*16                                      # seq_ring[17]: empty
  00*16                                      # seq_ring[18]: empty
  00*16                                      # seq_ring[19]: empty
  00*16                                      # seq_ring[20]: empty
  00*16                                      # seq_ring[21]: empty
  00*16                                      # seq_ring[22]: empty
  00*16                                      # seq_ring[23]: empty
  00*16                                      # seq_ring[24]: empty
  00*16                                      # seq_ring[25]: empty
  00*16                                      # seq_ring[26]: empty
  00*16                                      # seq_ring[27]: empty
  00*16                                      # seq_ring[28]: empty
  00*16                                      # seq_ring[29]: empty
  00*16                                      # seq_ring[30]: empty
  00*16                                      # seq_ring[31]: empty
  00*108                                     # _reserved0
  # init: InitParams (32 B, [F04 §4.4])
    {u64 65536}                                # log_extent_bytes
    {u32 4}                                    # hist_frame_commits
    {u32 4096}                                 # hist_frame_bytes
    57 01 de 00 00 00 00 00 00 00 00 00 00 00 00 08  # store_id
  {u64 0}                                    # epoch_lsn
  {u32 5}                                    # next_file_no
  {u32 2}                                    # next_ref_id
  01                                         # project_oid_algo
  00 00 00 00 00 00 00                       # _pad1
  {u64 0x1a0c456d4a00000}                    # hlc_seq: log.2 g12's BodyDrop ([F05 §10.2])
  {u64 0x1a0c45156600000}                    # hlc_commit: f1's hlc (f2 keeps an older imported one)
  00*2984                                    # _reserved1
  {xxh3_128 slotA..slotA+4080}               # xxh3_128 over [0, 4080) (low64, high64)
