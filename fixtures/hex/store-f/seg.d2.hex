# fixtures/hex/store-f/seg.d2.hex: store F's delta segment, the first and only layer of its main set,
# written by the purge's delta checkpoint (log.2 g10, [F16] P-101 step 2) over [0, 65674), the end of log.2's
# extent head. Rows #1 and #2 of main (#3 lives only on import/1, in cs.1, and has no row here, [F09 §5.1]).
# BLOBTAB: H1 as a dropped BlobRef and H2 live in blobs.3, sorted by hash ([F09 §6.3]; spec sync 3). SYMTAB
# holds the class-12 `model` symbol ([F09 §14.1]). DROPPED ([F11 §13.4]) has H1 and H3, HARVEST ([F11 §13.5],
# reserved for M9-M10) one live row in layer form; both are conditional and present because they hold rows
# ([F09 §14.5]). FILES as of upto_lsn names cs.1 only: blobs.3 enters with g10 itself, which lies at upto_lsn
# ([F09 §14.4]). IDEM has 16 empty slots; the derived-optional caches are absent; no tier-2 section.

# SegHdr (120 B, [F09 §2.1])
seghdr:
  "KSEG"                                     # magic
  {u16 1}                                    # format
  04                                         # seg_kind 4 `seg-delta`
  00                                         # tok_ver
  {u32 2}                                    # n_rows
  {u16 50}                                   # n_sections
  {u16 0}                                    # _reserved
  {u32 2}                                    # file_no
  {u32 0}                                    # ref_id
  {u32 0}                                    # dict_no
  {u32 0}                                    # _reserved
  {u64 2}                                    # base_seq
  {u64 0}                                    # from_lsn
  {u64 65674}                                # upto_lsn
  {u64 65674}                                # rt_upto_lsn
  {len 0..end u64}                           # total_len
  {blake3_256 data..end}                     # seg_digest: BLAKE3-256 over [data_off, total_len)
  {xxh3_64 table..data}                      # table_xxh3 over the section table
  {xxh3_64 0..112}                           # hdr_xxh3 over [0, 112)
# section table (50 entries of 32 B, [F09 §2.2])
table:
  # SecEnt IDS (0x0001)
  {u16 1}                                    # tag
  {u16 0}                                    # flags
  {u32 2}                                    # count
  {len 0..s_0001 u64}                        # off (absolute)
  {len s_0001..s_0001.e u64}                 # len
  {xxh3_64 s_0001..s_0001.e}                 # xxh3
  # SecEnt NODE (0x0002)
  {u16 2}                                    # tag
  {u16 0}                                    # flags
  {u32 2}                                    # count
