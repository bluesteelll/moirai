  4c b0 13 6d 60 0a 80 26 6e 5a 39 51 29 e3 61 91  # segments[0].blake3_16
  00*29                                     # segments[1]: empty
  00*29                                     # segments[2]: empty
  00*29                                     # segments[3]: empty
  00*29                                     # segments[4]: empty
  00*29                                     # segments[5]: empty
  00*29                                     # segments[6]: empty
  00*29                                     # segments[7]: empty
  {u64 15979}                               # refs_lsn
  {u64 19726}                               # pins_lsn
  {u64 16022}                               # heads_lsn
  {u64 8861}                                # markers_lsn
  # image_cursor: [4]ImageCursor (10 B each)
  01                                        # image_cursor[0].dest
  01                                        # image_cursor[0].algo
  {u64 7}                                   # image_cursor[0].seq
  02                                        # image_cursor[1].dest
  02                                        # image_cursor[1].algo
  {u64 3}                                   # image_cursor[1].seq
  00*10                                     # image_cursor[2]: empty
  00*10                                     # image_cursor[3]: empty
