# fixtures/hex/head/two-slot/old-torn.hex: slot A old, slot B torn ([F04 §8.2], the nine two-slot states).
# Store A at the end of its log.1 fixture; a durable publish that turns `quiet` on writes slot A (N1, slot_seq
# 42) and then slot B (N2, slot_seq 43) over O1 (slot_seq 40) and O2 (slot_seq 41). A torn slot mixes 512-byte
# pieces of the write and of the content it overwrote, so its checksum fails ([F04 §7] check 2).
# Selection ([F04 §8.1]): A: old (slot_seq 40).

# HeadSlot `slotA`: old: the state before the barrier (slot_seq 40) ([F04 §3])
slotA:
  "MOIR"                                    # magic
  {u16 1}                                   # format
  {u16 2}                                   # flags: quiet=0, fts_tier2=1, readonly=0, retired=0
  {u64 40}                                  # slot_seq
  {u64 0x3141592653589793}                  # epoch
  {u64 20090}                               # committed_lsn
  {u64 20090}                               # durable_lsn
  93 1c fe 48 ec 5a d8 55 33 32 51 cd e5 6f 62 c2  # boot_id
  {u32 0}                                   # config_gen
  {u64 16660}                               # checkpoint_lsn
  {u64 17}                                  # commit_seq
  {u32 17}                                  # next_id
  {u32 5}                                   # next_anchor
  {u64 3}                                   # fence
  {u32 1}                                   # active_log
  01                                        # n_segments
  00 00 00                                  # _pad0
  # segments: [8]SegRef (29 B each)
