%% arg selectors kind=quote quote="fn flush(&mut self)" prefix="pub " suffix=" -> io::Result<()> {"
%% steps
step 2: captured = 979e81a4e37ef2958b4112dc780b7430; u = uid_anchor(s, captured, empty) = c0d11c970f1d99bccc635f05d9b0f6ac
step 3: u is an anchor on (s, f); p = u; u = 1dd821c622ced2500f800bc519cb0550
