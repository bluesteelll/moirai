%% case cap-dedup
%% source [F08 §11.4]
%% note Step 1: an anchor on (s, f) has equal current selectors: it is reused, nothing is created.
%% operation capture
%% view
anchor 1fb4da2d86414ad798032f7ad3dc759e src=1a000000000000000000000000000002 dst=d7e09f2c74ffa63419395ac4e264198b captured=979e81a4e37ef2958b4112dc780b7430 pred=- kind=quote quote="fn flush(&mut self)" prefix="pub " suffix=" -> io::Result<()> {"
%% arg src 1a000000000000000000000000000002
%% arg dst d7e09f2c74ffa63419395ac4e264198b
%% arg selectors kind=quote quote="fn flush(&mut self)" prefix="pub " suffix=" -> io::Result<()> {"
%% steps
step 1: 1fb4da2d86414ad798032f7ad3dc759e has equal current selectors; it is reused
%% result reuse 1fb4da2d86414ad798032f7ad3dc759e
%% end

%% case cap-after-repin
%% source [F08 §11.4]
%% source [F08 §11.4] step 3
%% note The anchor captured from the same inputs was repinned (its current selectors differ, its uid and captured
%% note do not): no reuse, and u collides with its uid, so p = that uid.
%% operation capture
%% view
anchor 1fb4da2d86414ad798032f7ad3dc759e src=1a000000000000000000000000000002 dst=d7e09f2c74ffa63419395ac4e264198b captured=979e81a4e37ef2958b4112dc780b7430 pred=- kind=quote quote="fn flush(&mut self, group: &Group)" prefix="pub " suffix=" -> io::Result<()> {"
%% arg src 1a000000000000000000000000000002
%% arg dst d7e09f2c74ffa63419395ac4e264198b
%% arg selectors kind=quote quote="fn flush(&mut self)" prefix="pub " suffix=" -> io::Result<()> {"
%% steps
step 2: captured = 979e81a4e37ef2958b4112dc780b7430; u = uid_anchor(s, captured, empty) = 1fb4da2d86414ad798032f7ad3dc759e
step 3: u is an anchor on (s, f); p = u; u = 8ef3d186c4c5c3711fb6e4cf38c78310
%% result new 8ef3d186c4c5c3711fb6e4cf38c78310 captured 979e81a4e37ef2958b4112dc780b7430 pred 1fb4da2d86414ad798032f7ad3dc759e
%% end

