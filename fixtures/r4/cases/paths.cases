%% case p9-key-01
%% source [OS/path §4.5]
%% rule P9
%% function trees_key
%% note TREES key, HEADS directory-binding key: blake3_16 of the canonical text bytes.
%% arg text "C:/work/storage"
%% expect 67dbe02c270f1300ce038b02563b5a24
%% end

%% case p9-key-02
%% source [OS/path §4.5]
%% rule P9
%% function trees_key
%% note TREES key, HEADS directory-binding key: blake3_16 of the canonical text bytes.
%% arg text "//srv/share/repo"
%% expect 175c5f449dc579895e19953a3a4a36b6
%% end

%% case p9-key-03
%% source [OS/path §4.5]
%% rule P9
%% function trees_key
%% note TREES key, HEADS directory-binding key: blake3_16 of the canonical text bytes.
%% arg text "/home/dev/repo"
%% expect c45cfe515ee920da4c90d0091c4d9f69
%% end

%% case p9-lookup-01
%% source [OS/path §4.4]
%% source [OS/path §3] P9
%% note The root id matches: that row is the tree, whatever its spelling.
%% note Root ids are opaque tokens; 0 is kind 0 (no trusted id). Equal tokens are the same object.
%% rule P9
%% function lookup_tree
%% view
row r1 text="C:/work/storage" root_id=ntfs:1:aa os=windows
row r2 text="C:/work/other" root_id=ntfs:1:bb os=windows
%% arg text "C:/Work/Storage"
%% arg root_id ntfs:1:aa
%% arg os windows
%% expect r1
%% end

%% case p9-lookup-02
%% source [OS/path §4.4]
%% source [OS/path §3] P9
%% note No trusted id (kind 0): the row whose key equals the canonical text's key.
%% note Root ids are opaque tokens; 0 is kind 0 (no trusted id). Equal tokens are the same object.
%% rule P9
%% function lookup_tree
%% view
row r1 text="C:/work/storage" root_id=ntfs:1:aa os=windows
%% arg text "C:/work/storage"
%% arg root_id 0
%% arg os windows
%% expect r1
%% end

%% case p9-lookup-03
%% source [OS/path §4.4]
%% source [OS/path §3] P9
%% note A row written under another OS tag has an uninterpretable id and is found by spelling only.
%% note Root ids are opaque tokens; 0 is kind 0 (no trusted id). Equal tokens are the same object.
%% rule P9
%% function lookup_tree
%% view
row r1 text="/home/dev/repo" root_id=ext4:5:77 os=linux
%% arg text "/home/dev/repo"
%% arg root_id apfs:9:77
%% arg os macos
%% expect r1
%% end

%% case p9-lookup-04
%% source [OS/path §4.4]
%% source [OS/path §3] P9
%% note Neither the id nor the key matches: a new tree.
%% note Root ids are opaque tokens; 0 is kind 0 (no trusted id). Equal tokens are the same object.
%% rule P9
%% function lookup_tree
%% view
row r1 text="C:/work/storage" root_id=ntfs:1:aa os=windows
%% arg text "C:/work/storage2"
%% arg root_id ntfs:1:cc
%% arg os windows
%% expect new
%% end

%% case p9-lookup-05
%% source [OS/path §4.4]
%% source [OS/path §3] P9
%% note Id first: the id names r2 although the spelling is r1's.
%% note Root ids are opaque tokens; 0 is kind 0 (no trusted id). Equal tokens are the same object.
%% rule P9
%% function lookup_tree
%% view
row r1 text="C:/work/storage" root_id=ntfs:1:aa os=windows
row r2 text="D:/mirror/storage" root_id=ntfs:2:dd os=windows
%% arg text "C:/work/storage"
%% arg root_id ntfs:2:dd
%% arg os windows
%% expect r2
%% end

