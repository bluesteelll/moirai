%% case p3-01
%% source [OS/path §3] P3
%% note APFS, core.precomposeUnicode = true: NFC.
%% rule P3
%% function stored_untracked_name
%% arg text "cafe\u0301.md"
%% arg norm_insensitive_always true
%% arg git true
%% arg precompose_unicode true
%% expect "caf\u00e9.md"
%% expect-cps U+0063 U+0061 U+0066 U+00E9 U+002E U+006D U+0064
%% end

%% case p3-02
%% source [OS/path §3] P3
%% note APFS, precomposeUnicode false: the enumerated spelling.
%% rule P3
%% function stored_untracked_name
%% arg text "cafe\u0301.md"
%% arg norm_insensitive_always true
%% arg git true
%% arg precompose_unicode false
%% expect "cafe\u0301.md"
%% expect-cps U+0063 U+0061 U+0066 U+0065 U+0301 U+002E U+006D U+0064
%% end

%% case p3-03
%% source [OS/path §3] P3
%% note APFS without git: always NFC.
%% rule P3
%% function stored_untracked_name
%% arg text "cafe\u0301.md"
%% arg norm_insensitive_always true
%% arg git false
%% arg precompose_unicode false
%% expect "caf\u00e9.md"
%% expect-cps U+0063 U+0061 U+0066 U+00E9 U+002E U+006D U+0064
%% end

%% case p3-04
%% source [OS/path §3] P3
%% note Windows and Linux: never normalised.
%% rule P3
%% function stored_untracked_name
%% arg text "cafe\u0301.md"
%% arg norm_insensitive_always false
%% arg git true
%% arg precompose_unicode true
%% expect "cafe\u0301.md"
%% expect-cps U+0063 U+0061 U+0066 U+0065 U+0301 U+002E U+006D U+0064
%% end

%% case p3-05
%% source [OS/path §3] P3
%% note A Linux casefold directory (norm_follows_case) does not trigger P3.
%% rule P3
%% function stored_untracked_name
%% arg text "cafe\u0301.md"
%% arg norm_insensitive_always false
%% arg git false
%% arg precompose_unicode false
%% expect "cafe\u0301.md"
%% expect-cps U+0063 U+0061 U+0066 U+0065 U+0301 U+002E U+006D U+0064
%% end

%% case p3-06
%% source [OS/path §3] P3
%% note NFC maps the canonical singleton U+212B to U+00C5.
%% rule P3
%% function stored_untracked_name
%% arg text "\u212b.md"
%% arg norm_insensitive_always true
%% arg git false
%% arg precompose_unicode false
%% expect "\u00c5.md"
%% expect-cps U+00C5 U+002E U+006D U+0064
%% end

%% case p7-01
%% source [OS/path §3] P7, P2
%% source [F08 §11.2]
%% note Tracked: git's HEAD-tree spelling, whatever a case-insensitive volume enumerates.
%% rule P7
%% function origin_path
%% arg tracked true
%% arg git_spelling "Docs/Plan.md"
%% arg enumerated "docs/plan.md"
%% arg norm_insensitive_always false
%% expect "Docs/Plan.md"
%% end

%% case p7-02
%% source [OS/path §3] P7, P2
%% source [F08 §11.2]
%% note Untracked on NTFS: the enumerated spelling (P3 does not apply).
%% rule P7
%% function origin_path
%% arg tracked false
%% arg enumerated "docs/plan.md"
%% arg norm_insensitive_always false
%% expect "docs/plan.md"
%% end

%% case p7-03
%% source [OS/path §3] P7, P2
%% source [F08 §11.2]
%% note Untracked on NTFS: no normalisation; never case-folded.
%% rule P7
%% function origin_path
%% arg tracked false
%% arg enumerated "docs/cafe\u0301.md"
%% arg norm_insensitive_always false
%% expect "docs/cafe\u0301.md"
%% end

