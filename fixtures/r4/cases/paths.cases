%% case lexical-01
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note Separators \ and /; .. removes the previous segment; the drive letter is upper-cased.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os windows
%% arg text "c:\\Work\\a\\..\\b\\.\\c"
%% expect "C:/Work/b/c"
%% end

%% case lexical-02
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note .. never removes the drive.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os windows
%% arg text "C:/a/../../x"
%% expect "C:/x"
%% end

%% case lexical-03
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note .. never removes the //server/share prefix.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os windows
%% arg text "\\\\srv\\share\\x\\..\\..\\y"
%% expect "//srv/share/y"
%% end

%% case lexical-04
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note Empty segments are dropped.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os windows
%% arg text "D:/logs//run.txt"
%% expect "D:/logs/run.txt"
%% end

%% case lexical-05
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note A relative argument is joined to the canonical current directory.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os unix
%% arg cwd "/home/dev/repo"
%% arg text "../x//y/."
%% expect "/home/dev/x/y"
%% end

%% case lexical-06
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note .. never removes the leading /.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os unix
%% arg cwd "/home/dev"
%% arg text "/../../etc/./hosts"
%% expect "/etc/hosts"
%% end

%% case lexical-07
%% source [OS/path §5] step 2
%% source [OS/path §3] P12
%% note On Unix \ is a name character.
%% note Only inputs whose meaning needs no OS call: Windows arguments are absolute (a relative one goes through GetFullPathNameW, [OS/path §5]).
%% rule P12
%% function canonical_abs_lexical
%% arg os unix
%% arg cwd "/home/dev"
%% arg text "a\\b"
%% expect "/home/dev/a\\b"
%% end

%% case cli-01
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "lib.rs"
%% expect "src/lib.rs"
%% end

%% case cli-02
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% note \ becomes /.
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "..\\docs\\a.md"
%% expect "docs/a.md"
%% end

%% case cli-03
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% note An absolute argument; its drive letter is upper-cased by the lexical normalisation.
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "c:\\work\\repo\\README.md"
%% expect "README.md"
%% end

%% case cli-04
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% note A leading single / is the root of the current directory's drive.
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "/work/repo/Cargo.toml"
%% expect "Cargo.toml"
%% end

%% case cli-05
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% note The tree root gives the empty RelPath.
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo"
%% arg text "."
%% expect ""
%% end

%% case cli-06
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "C:/work/other/x.rs"
%% expect error OutsideRoot
%% end

%% case cli-07
%% source [OS/path §7]
%% source [OS/path §3] P4, P12
%% note The tree prefix is compared as bytes; the argument's spelling is kept, and mapping it to the on-disk spelling is the link layer's job.
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "C:/Work/repo/x.rs"
%% expect error OutsideRoot
%% end

