%% source [OS/path §3] P4, P12
%% note A bare X: is drive-relative.
%% rule CLI
%% function cli_path
%% arg os windows
%% arg tree "C:/work/repo"
%% arg cwd "C:/work/repo/src"
%% arg text "C:"
%% expect error DriveRelative
%% end

