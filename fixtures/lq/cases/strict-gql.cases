%% source [LQ/grammar-v1.ebnf §G.2]
%% source [LQ/gql-spelling §2.1]
%% entry read
%% mode strict-gql
%% input
MATCH (a)-[:BLOCKS*]->(b) RETURN a
%% error E004 1:19 conv
%% end

