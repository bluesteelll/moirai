    _)]
  []))
%% end

%% case sg-gql-star
%% source [LQ/grammar-v1.ebnf §G.2]
%% source [LQ/gql-spelling §2.1]
%% entry read
%% mode strict-gql
%% note GQL's * is zero or more; Cypher's -[:T*]-> is one or more ([LQ/canonical-ast §3.1] item 4).
%% input
MATCH (a)-[:BLOCKS]->*(b) RETURN a
%% tokens
KW MATCH
P (
NAME a
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P *
P (
NAME b
P )
KW RETURN
NAME a
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "a" [] [] _) [(estep (epat _ right ["BLOCKS"] (quant 0 _) [] _) (npat "b" [] [] _))])]
      _)]
    (return false false [(item (ident "a") _)] [] [] _)
    _)]
  []))
%% end

