%% source [LQ/grammar-v1.ebnf §G.2]
%% source [LQ/card §4]
%% entry read
%% mode strict-gql
%% note The card's Cypher example 2 is refused in the strict arm; its GQL line (§4) is accepted (sg-card-2-gql).
%% input
MATCH (x:task)-[:BLOCKS*1..]->(#51) WHERE x.unfinished RETURN x
%% error E004 1:24 conv
%% end

