%% case sg-gql-range
%% source [LQ/grammar-v1.ebnf §G.2]
%% source [LQ/gql-spelling §2.1]
%% entry read
%% mode strict-gql
%% input
MATCH (a)-[:BLOCKS]->{1,3}(b) RETURN a
%% tokens
KW MATCH
P (
NAME a
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P {
INT 1
P ,
INT 3
P }
P (
NAME b
P )
KW RETURN
NAME a
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "a" [] [] _) [(estep (epat _ right ["BLOCKS"] (quant 1 3) [] _) (npat "b" [] [] _))])]
      _)]
    (return false false [(item (ident "a") _)] [] [] _)
    _)]
  []))
%% end

