%% case pp-standalone-order-limit
%% source [LQ/grammar-v1.ebnf §P.7]
%% entry read
%% input
CALL blockers(#51, transitive: true) YIELD blocker, depth WHERE depth > 1 ORDER BY depth DESC, blocker LIMIT 5
%% tokens
KW CALL
NAME blockers
P (
NODE 51
P ,
NAME transitive
P :
KW TRUE
P )
KW YIELD
NAME blocker
P ,
NAME depth
KW WHERE
NAME depth
P >
INT 1
KW ORDER
KW BY
NAME depth
KW DESC
P ,
NAME blocker
KW LIMIT
INT 5
EOF -
%% sast
(read run
 (query
  [(part _ [] _ (scall "blockers" [(arg _ (nid 51)) (arg "transitive" (bool true))] items
   [(yitem "blocker" _) (yitem "depth" _)] (cmp > (ident "depth") (int 1))
   [(sort (ident "depth") desc) (sort (ident "blocker") asc)] (int 5)))]
  []))
%% end

%% case pp-call-clause-then-match
%% source [LQ/grammar-v1.ebnf §P.7]
%% entry read
%% input
CALL blockers(#51) YIELD blocker AS b MATCH (b)-[:CHILD_OF]->(p) RETURN b, p
%% tokens
KW CALL
NAME blockers
P (
NODE 51
P )
KW YIELD
NAME blocker
KW AS
NAME b
KW MATCH
P (
NAME b
P )
P -
P [
P :
NAME CHILD_OF
P ]
P ->
P (
NAME p
P )
KW RETURN
NAME b
P ,
NAME p
EOF -
%% sast
(read run
 (query
  [(part _
   [(call "blockers" [(arg _ (nid 51))] [(yitem "blocker" "b")] _)
    (match false _ [(path (npat "b" [] [] _) [(estep (epat _ right ["CHILD_OF"] _ [] _) (npat "p" [] [] _))])] _)]
   (return false false [(item (ident "b") _) (item (ident "p") _)] [] [] _) _)]
  []))
%% end

%% case pp-call-after-clause
%% source [LQ/grammar-v1.ebnf §P.7]
%% entry read
%% input
MATCH (t:task) CALL blockers(t) YIELD blocker WHERE blocker.status = 'open' RETURN t, blocker
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW CALL
NAME blockers
P (
NAME t
P )
KW YIELD
NAME blocker
KW WHERE
NAME blocker
P .
NAME status
P =
STR "open"
KW RETURN
NAME t
P ,
NAME blocker
EOF -
%% sast
(read run
 (query
  [(part _
   [(match false _ [(path (npat "t" ["task"] [] _) [])] _)
    (call "blockers" [(arg _ (ident "t"))] [(yitem "blocker" _)] (cmp = (prop (ident "blocker") "status") (str "open")))]
   (return false false [(item (ident "t") _) (item (ident "blocker") _)] [] [] _) _)]
  []))
%% end

%% case pp-count-forms
%% source [LQ/grammar-v1.ebnf §P.9]
%% entry read
%% note count( * ) and COUNT { are keyword forms; count(x) is a generic call (NAME).
%% input
MATCH (f:finding) RETURN count(*) AS a, count(f) AS b, count(DISTINCT f.round) AS c, COUNT { (f)-[:ABOUT]->() } AS d
%% tokens
KW MATCH
P (
NAME f
P :
NAME finding
P )
KW RETURN
KW COUNT
P (
P *
P )
KW AS
NAME a
P ,
NAME count
P (
NAME f
P )
KW AS
NAME b
P ,
NAME count
P (
KW DISTINCT
NAME f
P .
NAME round
P )
KW AS
NAME c
P ,
KW COUNT
P {
P (
NAME f
P )
P -
P [
P :
NAME ABOUT
P ]
P ->
P (
P )
P }
KW AS
NAME d
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "f" ["finding"] [] _) [])] _)]
   (return false false
    [(item (countstar) "a")
     (item (fn "count" false [(arg _ (ident "f"))]) "b")
     (item (fn "count" true [(arg _ (prop (ident "f") "round"))]) "c")
     (item (countsub (subp [(path (npat "f" [] [] _) [(estep (epat _ right ["ABOUT"] _ [] _) (npat _ [] [] _))])] _)) "d")]
    [] [] _) _)]
  []))
%% end

%% case pp-list-predicates
%% source [LQ/grammar-v1.ebnf §P.9]
%% entry read
%% input
MATCH (t:task) WHERE all(l IN t.labels WHERE l STARTS WITH 'l') AND any(x IN [1, 2] WHERE x > 1) AND none(g IN t.files_owned WHERE g ENDS WITH '.md') RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
KW ALL
P (
NAME l
KW IN
NAME t
P .
NAME labels
KW WHERE
NAME l
KW STARTS
KW WITH
STR "l"
P )
KW AND
KW ANY
P (
NAME x
KW IN
P [
INT 1
P ,
INT 2
P ]
KW WHERE
NAME x
P >
INT 1
P )
KW AND
KW NONE
P (
NAME g
KW IN
NAME t
P .
NAME files_owned
KW WHERE
NAME g
KW ENDS
KW WITH
STR ".md"
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
   [(match false _ [(path (npat "t" ["task"] [] _) [])]
     (and (and (listpred all "l" (prop (ident "t") "labels") (strpred starts (ident "l") (str "l")))
               (listpred any "x" (list [(int 1) (int 2)]) (cmp > (ident "x") (int 1))))
          (listpred none "g" (prop (ident "t") "files_owned") (strpred ends (ident "g") (str ".md")))))]
   (return false false [(item (ident "t") _)] [] [] _) _)]
  []))
%% end

%% case pp-case-subject
%% source [LQ/grammar-v1.ebnf] case_expr
%% entry read
%% input
MATCH (t:task) RETURN CASE t.status WHEN 'open' THEN 1 WHEN 'done' THEN 2 ELSE 0 END AS s
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW RETURN
KW CASE
NAME t
P .
NAME status
KW WHEN
STR "open"
KW THEN
INT 1
KW WHEN
STR "done"
KW THEN
INT 2
KW ELSE
INT 0
KW END
KW AS
NAME s
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "t" ["task"] [] _) [])] _)]
   (return false false
    [(item (case (prop (ident "t") "status") [(when (str "open") (int 1)) (when (str "done") (int 2))] (int 0)) "s")]
    [] [] _) _)]
  []))
%% end

%% case pp-with-forms
%% source [LQ/grammar-v1.ebnf §P.16]
%% entry read
%% input
MATCH (t:task) WITH DISTINCT *, t.status AS s WHERE s <> 'done' ORDER BY s LIMIT 10 RETURN s
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WITH
KW DISTINCT
P *
P ,
NAME t
P .
NAME status
KW AS
NAME s
KW WHERE
NAME s
P <>
STR "done"
KW ORDER
KW BY
NAME s
KW LIMIT
INT 10
KW RETURN
NAME s
EOF -
%% sast
(read run
 (query
  [(part _
   [(match false _ [(path (npat "t" ["task"] [] _) [])] _)
    (with true true [(item (prop (ident "t") "status") "s")] (cmp <> (ident "s") (str "done")) [(sort (ident "s") asc)] (int 10))]
   (return false false [(item (ident "s") _)] [] [] _) _)]
  []))
%% end

