TX { SET #1.x = 1, #2.y = 'b' }
%% tokens
KW TX
P {
KW SET
NODE 1
P .
NAME x
P =
INT 1
P ,
NODE 2
P .
NAME y
P =
STR "b"
P }
EOF -
%% sast
(tx _ _ _ _ _ _ [(smuts [(mset [(assign (nid 1) "x" (int 1)) (assign (nid 2) "y" (str "b"))])])] false)
%% end

%% case pp-tx-counter-increment
%% source [LQ/grammar-v1.ebnf] postfix_expr
%% entry write
%% input
TX { SET #1.reopen_count = #1.reopen_count + 1 }
%% tokens
KW TX
P {
KW SET
NODE 1
P .
NAME reopen_count
P =
NODE 1
P .
NAME reopen_count
P +
INT 1
P }
EOF -
%% sast
(tx _ _ _ _ _ _ [(smuts [(mset [(assign (nid 1) "reopen_count" (arith + (prop (nid 1) "reopen_count") (int 1)))])])] false)
%% end

%% case pp-define-entry
%% source [LQ/grammar-v1.ebnf §P.1]
%% entry define
%% input
DEFINE QUERY my.q($id: node, $days: int = 3, $tags: list<text>?) SHAPE node BUDGET light AS { MATCH (t) WHERE t = $id RETURN t }
%% tokens
KW DEFINE
KW QUERY
NAME my
P .
NAME q
P (
PARAM id
P :
NAME node
P ,
PARAM days
P :
NAME int
P =
INT 3
P ,
PARAM tags
P :
NAME list
P <
NAME text
P >
P ?
P )
KW SHAPE
NAME node
KW BUDGET
NAME light
KW AS
P {
KW MATCH
P (
NAME t
P )
KW WHERE
NAME t
P =
PARAM id
KW RETURN
NAME t
P }
EOF -
%% sast
(define "my.q"
 [(pdecl "id" (ptype "node" _) false _) (pdecl "days" (ptype "int" _) false (int 3)) (pdecl "tags" (ptype "list" "text") true _)]
 "node" "light"
 (query [(part _ [(match false _ [(path (npat "t" [] [] _) [])] (cmp = (ident "t") (param "id")))] (return false false [(item (ident "t") _)] [] [] _) _)] []))
%% end

