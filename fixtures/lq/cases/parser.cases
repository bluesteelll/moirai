%% case pp-set-operations
%% source [LQ/grammar-v1.ebnf] set_op
%% entry read
%% note Parts combine left to right; ops has one entry fewer than parts.
%% input
MATCH (a:task) RETURN a UNION ALL MATCH (b:doc) RETURN b INTERSECT MATCH (c) RETURN c UNION MATCH (d) RETURN d
%% tokens
KW MATCH
P (
NAME a
P :
NAME task
P )
KW RETURN
NAME a
KW UNION
KW ALL
KW MATCH
P (
NAME b
P :
NAME doc
P )
KW RETURN
NAME b
KW INTERSECT
KW MATCH
P (
NAME c
P )
KW RETURN
NAME c
KW UNION
KW MATCH
P (
NAME d
P )
KW RETURN
NAME d
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "a" ["task"] [] _) [])] _)] (return false false [(item (ident "a") _)] [] [] _) _)
   (part _ [(match false _ [(path (npat "b" ["doc"] [] _) [])] _)] (return false false [(item (ident "b") _)] [] [] _) _)
   (part _ [(match false _ [(path (npat "c" [] [] _) [])] _)] (return false false [(item (ident "c") _)] [] [] _) _)
   (part _ [(match false _ [(path (npat "d" [] [] _) [])] _)] (return false false [(item (ident "d") _)] [] [] _) _)]
  [union_all intersect union]))
%% end

%% case pp-optional-match
%% source [LQ/canonical-ast §3.2] match
%% entry read
%% input
MATCH (t:task) OPTIONAL MATCH (t)<-[:GATES]-(v:verdict) WHERE v.outcome = 'fail_fixable' RETURN t, v
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW OPTIONAL
KW MATCH
P (
NAME t
P )
P <-
P [
P :
NAME GATES
P ]
P -
P (
NAME v
P :
NAME verdict
P )
KW WHERE
NAME v
P .
NAME outcome
P =
STR "fail_fixable"
KW RETURN
NAME t
P ,
NAME v
EOF -
%% sast
(read run
 (query
  [(part _
   [(match false _ [(path (npat "t" ["task"] [] _) [])] _)
    (match true _ [(path (npat "t" [] [] _) [(estep (epat _ left ["GATES"] _ [] _) (npat "v" ["verdict"] [] _))])]
     (cmp = (prop (ident "v") "outcome") (str "fail_fixable")))]
   (return false false [(item (ident "t") _) (item (ident "v") _)] [] [] _) _)]
  []))
%% end

