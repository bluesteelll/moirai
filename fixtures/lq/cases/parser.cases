# fixtures/lq/cases/parser.cases: the parser of [LQ/grammar-v1.ebnf] (WP-22, R-FIX): the decisions of Annex P
# (accepted inputs with their S-AST, [LQ/canonical-ast §3]) and every refused form of Annex R with its code.
# Positions: 'spec' when the grammar's detection point fixes the token (the found token of a generic E001, the token
# a rule names); 'conv' otherwise: the first token of the refused form (INDEX.md §4 G-7).
# Format: fixtures/lq/INDEX.md §2.

%% case pp-paren-var-minus
%% source [LQ/grammar-v1.ebnf §P.5]
%% entry read
%% note (a) is a node pattern, but - followed by 1 is no edge operator, so no path is attempted.
%% input
MATCH (a:task) RETURN (a) - 1 AS x
%% tokens
KW MATCH
P (
NAME a
P :
NAME task
P )
KW RETURN
P (
NAME a
P )
P -
INT 1
KW AS
NAME x
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "a" ["task"] [] _) [])] _)]
   (return false false [(item (arith - (ident "a") (int 1)) "x")] [] [] _) _)]
  []))
%% end

%% case pp-path-pred-undirected
%% source [LQ/grammar-v1.ebnf §P.5]
%% entry read
%% note (a) followed by - - is a path: a pattern predicate.
%% input
MATCH (a:task), (b:task) RETURN (a)--(b) AS linked
%% tokens
KW MATCH
P (
NAME a
P :
NAME task
P )
P ,
P (
NAME b
P :
NAME task
P )
KW RETURN
P (
NAME a
P )
P -
P -
P (
NAME b
P )
KW AS
NAME linked
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "a" ["task"] [] _) []) (path (npat "b" ["task"] [] _) [])] _)]
   (return false false
    [(item (exists (subp [(path (npat "a" [] [] _) [(estep (epat _ both [] _ [] _) (npat "b" [] [] _))])] _)) "linked")]
    [] [] _) _)]
  []))
%% end

%% case pp-path-pred-group
%% source [LQ/grammar-v1.ebnf §P.5], §P.6
%% entry read
%% note A '(' after the first node pattern also starts a path: a quantified group inside a pattern predicate.
%% input
MATCH (a:task), (b:task) WHERE (a)((x)-[:BLOCKS]->(y)){1,3}(b) RETURN a
%% tokens
KW MATCH
P (
NAME a
P :
NAME task
P )
P ,
P (
NAME b
P :
NAME task
P )
KW WHERE
P (
NAME a
P )
P (
P (
NAME x
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P (
NAME y
P )
P )
P {
INT 1
P ,
INT 3
P }
P (
NAME b
P )
KW RETURN
NAME a
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "a" ["task"] [] _) []) (path (npat "b" ["task"] [] _) [])]
     (exists (subp [(path (npat "a" [] [] _)
                          [(gstep (group (path (npat "x" [] [] _) [(estep (epat _ right ["BLOCKS"] _ [] _) (npat "y" [] [] _))]) _ (quant 1 3))
                                  (npat "b" [] [] _))])] _)))]
   (return false false [(item (ident "a") _)] [] [] _) _)]
  []))
%% end

%% case pp-label-test-argument
%% source [LQ/grammar-v1.ebnf §P.10]
%% entry read
%% note A label test in an argument list needs parentheses.
%% input
MATCH (k) RETURN coalesce((k:note), false) AS n
%% tokens
KW MATCH
P (
NAME k
P )
KW RETURN
NAME coalesce
P (
P (
NAME k
P :
NAME note
P )
P ,
KW FALSE
P )
KW AS
NAME n
EOF -
%% sast
(read run
 (query
  [(part _ [(match false _ [(path (npat "k" [] [] _) [])] _)]
   (return false false
    [(item (fn "coalesce" false [(arg _ (labeltest (ident "k") ["note"])) (arg _ (bool false))]) "n")] [] [] _) _)]
  []))
%% end

%% case pp-named-argument-case
%% source [LQ/grammar-v1.ebnf §P.10], O-10
%% entry read
%% note Named-argument names are case-sensitive and kept as written; the binder refuses the unknown name (E109).
%% input
CALL blockers(#51, Transitive: true) YIELD blocker
%% tokens
KW CALL
NAME blockers
P (
NODE 51
P ,
NAME Transitive
P :
KW TRUE
P )
KW YIELD
NAME blocker
EOF -
%% sast
(read run
 (query
  [(part _ [] _ (scall "blockers" [(arg _ (nid 51)) (arg "Transitive" (bool true))] items [(yitem "blocker" _)] _ [] _))]
  []))
%% end

