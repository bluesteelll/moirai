%% case pp-predicates
%% source [LQ/canonical-ast §3.1] items 2 and 3
%% entry read
%% note x NOT IN y gives not(in(x, y)); IS NOT NULL gives isnull with neg = true; AND is left-associative.
%% input
MATCH (t:task) WHERE t.title STARTS WITH 'A' AND t.title ENDS WITH 'z' AND t.title CONTAINS 'm' AND t.assignee IS NULL AND t.parent IS NOT NULL AND t.status NOT IN ['done'] AND t:task|doc RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME title
KW STARTS
KW WITH
STR "A"
KW AND
NAME t
P .
NAME title
KW ENDS
KW WITH
STR "z"
KW AND
NAME t
P .
NAME title
KW CONTAINS
STR "m"
KW AND
NAME t
P .
NAME assignee
KW IS
KW NULL
KW AND
NAME t
P .
NAME parent
KW IS
KW NOT
KW NULL
KW AND
NAME t
P .
NAME status
KW NOT
KW IN
P [
STR "done"
P ]
KW AND
NAME t
P :
NAME task
P |
NAME doc
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
   [(match false _ [(path (npat "t" ["task"] [] _) [])]
     (and (and (and (and (and (and (strpred starts (prop (ident "t") "title") (str "A"))
                                   (strpred ends (prop (ident "t") "title") (str "z")))
                              (strpred contains (prop (ident "t") "title") (str "m")))
                         (isnull false (prop (ident "t") "assignee")))
                    (isnull true (prop (ident "t") "parent")))
               (not (in (prop (ident "t") "status") (list [(str "done")]))))
          (labeltest (ident "t") ["task" "doc"])))]
   (return false false [(item (ident "t") _)] [] [] _) _)]
  []))
%% end

