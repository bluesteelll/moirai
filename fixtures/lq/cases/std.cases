P (
NAME f
P :
NAME finding
P )
KW WHERE
KW EXISTS
P {
KW MATCH
P (
NAME f
P )
P -
P [
P :
NAME ABOUT
P ]
P ->
P (
NAME x
P )
KW WHERE
NAME x
KW IN
NAME subtree
P (
PARAM target
P )
P }
KW AND
KW CASE
PARAM role
KW WHEN
STR "developer"
KW THEN
NAME f
P .
NAME status
P =
STR "confirmed"
KW WHEN
STR "architecture-critic"
KW THEN
NAME f
P .
NAME created_role
P =
PARAM role
KW AND
P (
PARAM round
KW IS
KW NULL
KW OR
NAME coalesce
P (
NAME f
P .
NAME round
P ,
INT 0
P )
P <=
PARAM round
P )
KW WHEN
STR "code-reviewer"
KW THEN
NAME f
P .
NAME created_role
P =
PARAM role
KW OR
NAME f
P .
NAME status
P =
STR "open"
KW ELSE
NAME f
P .
NAME status
KW IN
P [
STR "open"
P ,
STR "confirmed"
P ]
KW END
KW RETURN
NAME f
KW ORDER
KW BY
NAME f
P .
NAME severity
P ,
NAME f
P .
NAME id
P }
EOF -
%% end

