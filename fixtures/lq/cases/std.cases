# Format: fixtures/lq/INDEX.md §2.

%% case std-ready
%% source [LQ/std §4.1]
%% entry define
%% input-file std/ready.lq
%% tokens
KW DEFINE
KW QUERY
NAME ready
P (
PARAM scope
P :
NAME node
P ?
P =
KW NULL
P ,
PARAM role
P :
NAME text
P ?
P =
KW NULL
P ,
PARAM limit
P :
NAME int
P =
INT 20
P )
KW SHAPE
NAME node
KW BUDGET
NAME light
KW AS
P {
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME ready
KW AND
P (
PARAM scope
KW IS
KW NULL
KW OR
NAME t
KW IN
NAME subtree
P (
PARAM scope
P )
P )
KW AND
P (
PARAM role
KW IS
KW NULL
KW OR
NAME fits_role
P (
NAME t
P ,
PARAM role
P )
P )
KW RETURN
NAME t
KW ORDER
KW BY
NAME t
P .
NAME priority
P ,
NAME t
P .
NAME id
KW LIMIT
PARAM limit
P }
EOF -
%% end

