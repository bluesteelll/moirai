%% case tx-add
%% source [LQ/std §7.2]
%% entry write
%% note CREATE (n:task ...) is a create statement; CREATE (#12)-[:BLOCKS]->(n) is the edge mutation ([LQ/grammar-v1.ebnf §P.11]).
%% input
TX { CREATE (n:task {title: $title}) UNDER #88; CREATE (#12)-[:BLOCKS]->(n) }
%% tokens
KW TX
P {
KW CREATE
P (
NAME n
P :
NAME task
P {
NAME title
P :
PARAM title
P }
P )
KW UNDER
NODE 88
P ;
KW CREATE
P (
NODE 12
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P (
NAME n
P )
P }
EOF -
%% sast
(tx _ _ _ _ _ _
 [(screate "n" "task" [(kv "title" (param "title"))] [] (nid 88) _)
  (smuts [(medge (nid 12) right "BLOCKS" [] (ident "n"))])]
 false)
%% end

