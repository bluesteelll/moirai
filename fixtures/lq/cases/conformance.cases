P (
NAME a
P :
NAME task
P )
KW WHERE
KW EXISTS
P {
P (
NAME a
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P (
P )
P }
KW RETURN
NAME a
EOF -
%% sast-same-as exists-fn-pattern
%% end

%% case size-fn-pattern
%% source [50 §2.8]
%% source [LQ/grammar-v1.ebnf §P.9]
%% source [LQ/canonical-ast §3.1] item 5
%% entry read
