%% case pattern-predicate
%% source [50 §0.4]
%% source [50 §2.9] mistake 1
%% source [LQ/canonical-ast §3.1] item 5
%% entry read
%% note NOT (t)<-[:BLOCKS]-() is NOT EXISTS { (t)<-[:BLOCKS]-() }.
%% input
MATCH (t:task) WHERE t.status = 'open' AND NOT (t)<-[:BLOCKS]-() RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME status
P =
STR "open"
KW AND
KW NOT
P (
NAME t
P )
P <-
P [
P :
NAME BLOCKS
P ]
P -
P (
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "t" ["task"] [] _) [])]
      (and (cmp = (prop (ident "t") "status") (str "open"))
           (not (exists (subp [(path (npat "t" [] [] _)
                                     [(estep (epat _ left ["BLOCKS"] _ [] _) (npat _ [] [] _))])]
                              _)))))]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% end

