MATCH (t:task) RETURN t, size((t)<-[:BLOCKS]-()) AS n
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW RETURN
NAME t
P ,
KW SIZE
P (
P (
NAME t
P )
P <-
P [
P :
NAME BLOCKS
P ]
P -
P (
P )
P )
KW AS
NAME n
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _ [(path (npat "t" ["task"] [] _) [])] _)]
    (return false false
     [(item (ident "t") _)
      (item (countsub (subp [(path (npat "t" [] [] _) [(estep (epat _ left ["BLOCKS"] _ [] _) (npat _ [] [] _))])] _)) "n")]
     [] [] _)
    _)]
  []))
%% end

%% case exists-fn-property
%% source [50 §2.8]
%% source [LQ/grammar-v1.ebnf §P.9]
%% source [LQ/canonical-ast §3.1] item 6
%% entry read
%% note exists(e) with one positional argument that is not a path is e IS NOT NULL.
%% input
MATCH (t:task) WHERE exists(t.assignee) RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
KW EXISTS
P (
NAME t
P .
NAME assignee
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "t" ["task"] [] _) [])]
      (isnull true (prop (ident "t") "assignee")))]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% end

%% case quant-cypher
%% source [LQ/canonical-ast §3.1] item 4
%% source [LQ/gql-spelling §2.1]
%% entry read
%% input
MATCH (x:task)-[:BLOCKS*1..3]->(y) RETURN x
%% tokens
KW MATCH
P (
NAME x
P :
NAME task
P )
P -
P [
P :
NAME BLOCKS
P *
INT 1
P ..
INT 3
P ]
P ->
P (
NAME y
P )
KW RETURN
NAME x
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "x" ["task"] [] _) [(estep (epat _ right ["BLOCKS"] (quant 1 3) [] _) (npat "y" [] [] _))])]
      _)]
    (return false false [(item (ident "x") _)] [] [] _)
    _)]
  []))
%% end

%% case quant-gql
%% source [LQ/canonical-ast §3.1] item 4
%% source [LQ/gql-spelling §2.1]
%% entry read
%% note The Cypher and GQL spellings of one quantifier give one S-AST.
%% input
MATCH (x:task)-[:BLOCKS]->{1,3}(y) RETURN x
%% tokens
KW MATCH
P (
NAME x
P :
NAME task
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P {
INT 1
P ,
INT 3
P }
P (
NAME y
P )
KW RETURN
NAME x
EOF -
%% sast-same-as quant-cypher
%% end

%% case quant-group
%% source [50 §2.9] Q5
%% source [LQ/json-ir §7] Q5
%% source [LQ/grammar-v1.ebnf §P.6]
%% entry read
%% input
MATCH (x:task)((a:task)-[:BLOCKS]->(b) WHERE a.unfinished){1,5}(#93) RETURN x
%% tokens
KW MATCH
P (
NAME x
P :
NAME task
P )
P (
P (
NAME a
P :
NAME task
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P (
NAME b
P )
KW WHERE
NAME a
P .
NAME unfinished
P )
P {
INT 1
P ,
INT 5
P }
P (
NODE 93
P )
KW RETURN
NAME x
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "x" ["task"] [] _)
             [(gstep (group (path (npat "a" ["task"] [] _)
                                  [(estep (epat _ right ["BLOCKS"] _ [] _) (npat "b" [] [] _))])
                            (prop (ident "a") "unfinished")
                            (quant 1 5))
                     (npat _ [] [(kv "id" (nid 93))] _))])]
      _)]
    (return false false [(item (ident "x") _)] [] [] _)
    _)]
  []))
%% json-ir
{"t":"read","query":{"t":"query","parts":[{"t":"part","clauses":[{"t":"match","patterns":[{"t":"path","start":{"t":"npat","var":"x","labels":["task"]},"steps":[{"t":"gstep","group":{"t":"group","path":{"t":"path","start":{"t":"npat","var":"a","labels":["task"]},"steps":[{"t":"estep","edge":{"t":"epat","dir":"right","types":["BLOCKS"]},"node":{"t":"npat","var":"b"}}]},"where":{"t":"prop","e":{"t":"ident","name":"a"},"name":"unfinished"},"quant":{"t":"quant","min":1,"max":5}},"node":{"t":"npat","props":[{"t":"kv","key":"id","value":{"t":"nid","n":93}}]}}]}]}],"return":{"t":"return","items":[{"t":"item","expr":{"t":"ident","name":"x"}}]}}]}}
%% end

%% case composite-use
%% source [50 §2.9] Q15
%% source [50 §3.9] item 2
%% entry read
%% input
MATCH (t:task) WHERE t.unblocked RETURN t EXCEPT USE main~5 MATCH (t:task) WHERE t.unblocked RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME unblocked
KW RETURN
NAME t
KW EXCEPT
KW USE
REF main
SUF ~5
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME unblocked
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _ [(path (npat "t" ["task"] [] _) [])] (prop (ident "t") "unblocked"))]
    (return false false [(item (ident "t") _)] [] [] _)
    _)
   (part (rsuf (rref "main") tilde 5 _)
    [(match false _ [(path (npat "t" ["task"] [] _) [])] (prop (ident "t") "unblocked"))]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  [except]))
%% end

