%% source [50 §2.2] rule 6
%% source [LQ/lexical §7.2] rule 2
%% entry read
%% input
CALL log(s4400..s4480) YIELD commit, seq
%% tokens
KW CALL
NAME log
P (
SEQ 4400
RANGE ..
SEQ 4480
P )
KW YIELD
NAME commit
P ,
NAME seq
EOF -
%% sast
(read run
 (query
  [(part _ [] _
    (scall "log" [(arg _ (rrange (rseq 4400) two (rseq 4480)))]
     items [(yitem "commit" _) (yitem "seq" _)] _ [] _))]
  []))
%% end

%% case use-suffixes
%% source [LQ/lexical §7.3]
%% source [LQ/canonical-ast §3.1] item 12
%% source [LQ/grammar-v1.ebnf] O-2
%% entry read
%% note An omitted count is 1; REF@{n} is REF@n; suffixes nest left to right.
%% input
USE main~^2@{3} MATCH (t) RETURN t
%% tokens
KW USE
REF main
SUF ~1
SUF ^2
SUF @3
KW MATCH
P (
NAME t
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part (rsuf (rsuf (rsuf (rref "main") tilde 1 _) caret 2 _) at 3 _)
    [(match false _ [(path (npat "t" [] [] _) [])] _)]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% end

%% case use-datetime
%% source [LQ/lexical §11.2]
%% source [LQ/lexical §7.5]
%% entry read
%% input
USE main@2026-09-25T10:00Z MATCH (s1:doc) WHERE s1 IN subtree(#130) RETURN s1
%% tokens
KW USE
REF main
SUF @2026-09-25T10:00:00Z
KW MATCH
P (
NAME s1
P :
NAME doc
P )
KW WHERE
NAME s1
KW IN
NAME subtree
P (
NODE 130
P )
KW RETURN
NAME s1
EOF -
%% sast
(read run
 (query
  [(part (rsuf (rref "main") attime _ "2026-09-25T10:00:00Z")
    [(match false _
      [(path (npat "s1" ["doc"] [] _) [])]
      (in (ident "s1") (fn "subtree" false [(arg _ (nid 130))])))]
    (return false false [(item (ident "s1") _)] [] [] _)
    _)]
  []))
%% end

%% case commit-literal
%% source [LQ/lexical §7.2] rule 1
%% entry read
%% note In a revision position c followed by 7 to 64 lower-case hex digits is a commit literal.
%% input
USE c9b2e6c1 MATCH (t:task) RETURN t
%% tokens
KW USE
COMMIT 9b2e6c1
KW MATCH
P (
NAME t
P :
NAME task
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part (rcommit "9b2e6c1")
    [(match false _ [(path (npat "t" ["task"] [] _) [])] _)]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% end

%% case short-hex-is-ref
%% source [LQ/lexical §7.2]
%% source [LQ/lexical] L-8
%% entry read
%% note Six hex digits are not a commit literal: a ref name, which the binder reports as E301 if no such ref exists.
%% input
USE c123456 MATCH (t:task) RETURN t
%% tokens
KW USE
REF c123456
KW MATCH
P (
NAME t
P :
NAME task
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part (rref "c123456")
    [(match false _ [(path (npat "t" ["task"] [] _) [])] _)]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% end

%% case head-suffix
%% source [LQ/lexical §7.2]
%% source [LQ/grammar-v1.ebnf] O-3
%% entry read
%% input
CALL log(HEAD~3) YIELD commit
%% tokens
KW CALL
NAME log
P (
HEAD HEAD
SUF ~3
P )
KW YIELD
NAME commit
EOF -
%% sast
(read run
 (query
  [(part _ [] _
    (scall "log" [(arg _ (rsuf (rhead) tilde 3 _))] items [(yitem "commit" _)] _ [] _))]
  []))
%% end

%% case rev-list
%% source [50 §2.9] Q12
%% source [LQ/lexical §7.4]
%% source [LQ/std §2.8] item 1
%% entry read
%% note refs is a revision position (a revision list); ids is an ordinary list. A CALL followed by RETURN is a call clause.
%% input
CALL across(refs: [main, lane/l5np], ids: [#89, #93]) YIELD node, name, ref, value, diverged WHERE diverged RETURN node, name, ref, value
%% tokens
KW CALL
NAME across
P (
NAME refs
P :
P [
REF main
P ,
REF lane/l5np
P ]
P ,
NAME ids
P :
P [
NODE 89
P ,
NODE 93
P ]
P )
KW YIELD
NAME node
P ,
NAME name
P ,
NAME ref
P ,
NAME value
P ,
NAME diverged
KW WHERE
NAME diverged
KW RETURN
NAME node
P ,
NAME name
P ,
NAME ref
P ,
NAME value
EOF -
%% sast
(read run
 (query
  [(part _
    [(call "across"
      [(arg "refs" (rlist [(rref "main") (rref "lane/l5np")]))
       (arg "ids" (list [(nid 89) (nid 93)]))]
      [(yitem "node" _) (yitem "name" _) (yitem "ref" _) (yitem "value" _) (yitem "diverged" _)]
      (ident "diverged"))]
    (return false false
     [(item (ident "node") _) (item (ident "name") _) (item (ident "ref") _) (item (ident "value") _)]
     [] [] _)
    _)]
  []))
%% end

%% case rev-quoted-arg
%% source [LQ/lexical §4.2]
%% source [LQ/grammar-v1.ebnf §P.2]
%% entry read
%% note A quote at a revision argument position means an ordinary expression, a string the binder coerces.
%% input
CALL diff('main...lane/l10') YIELD change
%% tokens
KW CALL
NAME diff
P (
STR "main...lane/l10"
P )
KW YIELD
NAME change
EOF -
%% sast
(read run
 (query
  [(part _ [] _
    (scall "diff" [(arg _ (str "main...lane/l10"))] items [(yitem "change" _)] _ [] _))]
  []))
%% end

%% case tx-options
%% source [LQ/grammar-v1.ebnf §P.12]
%% source [LQ/canonical-ast §3.1] item 14
%% entry write
%% note TX options in any order go into fixed fields.
%% input
TX IF TIP c9b2e6c1 MESSAGE 'reprio' ON lane/l5np KEY 'k1' { SET #89.priority = 1 } DRY
%% tokens
KW TX
KW IF
KW TIP
COMMIT 9b2e6c1
KW MESSAGE
STR "reprio"
KW ON
REF lane/l5np
KW KEY
STR "k1"
P {
KW SET
NODE 89
P .
NAME priority
P =
INT 1
P }
KW DRY
EOF -
%% sast
(tx (rref "lane/l5np") (rcommit "9b2e6c1") _ "k1" _ "reprio"
