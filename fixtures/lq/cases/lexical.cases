%% source [LQ/lexical §4.2]
%% entry read
%% input
CALL log(range: main..lane/x, actor: 'dev#1') YIELD commit
%% tokens
KW CALL
NAME log
P (
NAME range
P :
REF main
RANGE ..
REF lane/x
P ,
NAME actor
P :
STR "dev#1"
P )
KW YIELD
NAME commit
EOF -
%% end

%% case lx-rev-relation-case
%% source [LQ/lexical §4.2]
%% entry read
%% note The relation name is matched ASCII-case-insensitively; the token keeps the written word.
%% input
CALL LOG(main..lane/x) YIELD commit
%% tokens
KW CALL
NAME LOG
P (
REF main
RANGE ..
REF lane/x
P )
KW YIELD
NAME commit
EOF -
%% end

%% case lx-rev-param-arg
%% source [LQ/lexical §4.2]
%% entry read
%% note A $ at a revision argument is a parameter.
%% input
CALL log($r) YIELD commit
%% tokens
KW CALL
NAME log
P (
PARAM r
P )
KW YIELD
NAME commit
EOF -
%% end

%% case lx-rev-double-quoted-arg
%% source [LQ/lexical §4.2]
%% entry read
%% input
CALL diff("main...lane/x") YIELD change
%% tokens
KW CALL
NAME diff
P (
STR "main...lane/x"
P )
KW YIELD
NAME change
EOF -
%% end

%% case lx-rev-std-not-revision
%% source [LQ/lexical §4.2]
%% entry read
%% note std.log is not a revision position: main is a word the binder coerces.
%% input
CALL std.log(main) YIELD commit
%% tokens
KW CALL
NAME std
P .
NAME log
P (
NAME main
P )
KW YIELD
NAME commit
EOF -
%% end

%% case lx-rev-range-whitespace
%% source [LQ/lexical §7.4]
%% entry read
%% note Whitespace around the range operator is a leniency (L-5).
%% input
CALL log(main .. lane/x) YIELD commit
%% tokens
KW CALL
NAME log
P (
REF main
RANGE ..
REF lane/x
P )
KW YIELD
NAME commit
EOF -
%% end

%% case lx-rev-list-comments
%% source [LQ/lexical §7.4]
%% entry read
%% note Whitespace and comments are allowed around list elements and commas.
%% input
CALL across(refs: [ main /* a */ , lane/x ], ids: [#1]) YIELD node
%% tokens
KW CALL
NAME across
P (
NAME refs
P :
P [
REF main
P ,
REF lane/x
P ]
P ,
NAME ids
P :
P [
NODE 1
P ]
P )
KW YIELD
NAME node
EOF -
%% end

%% case lx-rev-comment-before
%% source [LQ/lexical §3]
%% entry read
%% note Comments may stand before a revision.
%% input
USE /* v */ main MATCH (t) RETURN t
%% tokens
KW USE
REF main
KW MATCH
P (
NAME t
P )
KW RETURN
NAME t
EOF -
%% end

%% case lx-rev-tx-options
%% source [LQ/lexical §4.2]
%% entry write
%% input
TX ON lane/x IF TIP HEAD~1 { SET #1.a = 1 }
%% tokens
KW TX
KW ON
REF lane/x
KW IF
KW TIP
HEAD HEAD
SUF ~1
P {
KW SET
NODE 1
P .
NAME a
P =
INT 1
P }
EOF -
%% end

%% case lx-question-mark-param-decl
%% source [LQ/lexical §5.9]
%% entry define
%% note ? is valid only after a param_decl type.
%% input
DEFINE QUERY q($a: int?) AS { RETURN $a }
%% tokens
KW DEFINE
KW QUERY
NAME q
P (
PARAM a
P :
NAME int
P ?
P )
KW AS
P {
KW RETURN
PARAM a
P }
EOF -
%% end

