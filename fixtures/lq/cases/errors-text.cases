%% case e005-file-line-10
%% source [LQ/errors §3.2], §5.2 E005
%% entry read
%% transport file q.lq
%% context branch main
%% context rev 4480
%% note moirai q -f q.lq; a two-digit line number widens the gutter (w = 2).
%% input
MATCH (t:task)
WHERE t.status = 'open'
  AND t.priority <= 1
  AND 'l5' IN t.labels
  AND t.unblocked
  AND t.estimate IS NULL
  AND NOT t.suspect
  AND NOT t.conflicted
  AND t.work_kind = 'code'
RETURN t;
%% error E005 10:9 spec
%% text
error[E005 one_statement]: one statement per call; a second statement starts here
  --> q.lq:10:9
   |
10 | RETURN t;
   |         ^
   = help: send each statement in its own call, or put writes in one TX { ... } block
%% json
{"v":1,"branch":"main","rev":4480,"errors":[{"code":"E005","name":"one_statement","severity":"error","span":{"start":205,"end":206,"line":10,"col":9},"message":"one statement per call; a second statement starts here","suggest":[],"expected":[],"help":"send each statement in its own call, or put writes in one TX { ... } block","detail":[]}],"exit":2}
%% end

%% case e005-excerpt-cut
%% source [LQ/errors §3.2], §5.2 E005
%% entry read
%% transport argv
%% context branch main
%% context rev 4480
%% note The excerpt keeps 60 scalars on each side of the span and marks both cuts with ...; the leading ... counts in the pad.
%% input
RETURN 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'; RETURN 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'
%% error E005 1:80 spec
%% text
error[E005 one_statement]: one statement per call; a second statement starts here
 --> <argv>:1:80
  |
1 | ...aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'; RETURN 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb...
  |                                                                ^
  = help: send each statement in its own call, or put writes in one TX { ... } block
%% json
{"v":1,"branch":"main","rev":4480,"errors":[{"code":"E005","name":"one_statement","severity":"error","span":{"start":79,"end":80,"line":1,"col":80},"message":"one statement per call; a second statement starts here","suggest":[],"expected":[],"help":"send each statement in its own call, or put writes in one TX { ... } block","detail":[]}],"exit":2}
%% end

