%% case e002-string
%% source [LQ/errors §3.2], §5.2 E002
%% entry read
%% transport argv
%% context branch main
%% context rev 4480
%% note The span is the opening delimiter ([LQ/errors §5.2] E002).
%% input
RETURN 'abc
%% error E002 1:8 spec
%% text
error[E002 unterminated]: unterminated string
 --> <argv>:1:8
  |
1 | RETURN 'abc
  |        ^
  = help: close it with ' on the same line; write a line break as \n
%% json
{"v":1,"branch":"main","rev":4480,"errors":[{"code":"E002","name":"unterminated","severity":"error","span":{"start":7,"end":8,"line":1,"col":8},"message":"unterminated string","suggest":[],"expected":[],"help":"close it with ' on the same line; write a line break as \\n","detail":[]}],"exit":2}
%% end

