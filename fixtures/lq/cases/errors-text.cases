%% note conv: the span is the comparison operator.
%% input
MATCH (t:task) WHERE t.assignee = null RETURN t
%% error E118 1:33 conv
%% text
error[E118 null_comparison]: a comparison with NULL is never true
 --> <argv>:1:33
