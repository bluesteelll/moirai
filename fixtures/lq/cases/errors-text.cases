%% case e113-path-variable
%% source [LQ/errors §3.2], §5.2 E113
%% entry read
%% transport argv
%% context branch main
%% context rev 4480
%% note The inline names the pattern's anchor id; the span is the path variable.
%% input
MATCH p = (a)-[:BLOCKS]->(#51) RETURN p
%% error E113 1:7 spec
%% text
error[E113 path_variable]: path variables are not in LQ v1
 --> <argv>:1:7
  |
1 | MATCH p = (a)-[:BLOCKS]->(#51) RETURN p
  |       ^ write CALL blockers(#51, transitive: true) YIELD blocker, depth, via
  = help: sets of endpoints need no path variable
%% json
{"v":1,"branch":"main","rev":4480,"errors":[{"code":"E113","name":"path_variable","severity":"error","span":{"start":6,"end":7,"line":1,"col":7},"message":"path variables are not in LQ v1","suggest":[],"expected":[],"help":"sets of endpoints need no path variable","detail":[]}],"exit":2}
%% end

