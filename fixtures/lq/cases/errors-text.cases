%% case e001-where-after-return
%% source [LQ/errors §3.2], §5.2 E001
%% entry read
%% transport argv
%% context branch main
%% context rev 4480
%% note conv: the span is the keyword. The rewrite prints the query's own items and predicate (display printer).
%% note No JSON: the expected list of a special-case E001 is not fixed (INDEX.md §4 G-10).
%% input
MATCH (t:task) RETURN t WHERE t.priority = 1
%% error E001 1:25 spec
%% text
error[E001 syntax]: WHERE after RETURN filters nothing
 --> <argv>:1:25
  |
1 | MATCH (t:task) RETURN t WHERE t.priority = 1
  |                         ^^^^^ write WITH t WHERE t.priority = 1 RETURN t
  = help: filter rows or groups with WITH ... WHERE before RETURN
%% end

%% case e001-dollar
%% source [LQ/errors §3.2], §5.2 E001
%% entry read
%% transport argv
%% context branch main
%% context rev 4480
%% note conv: the span is the $.
%% input
RETURN $1
%% error E001 1:8 conv
%% text
error[E001 syntax]: $ must be followed by a parameter name
 --> <argv>:1:8
  |
1 | RETURN $1
  |        ^
  = help: parameter names start with a letter or _
%% end

%% case e001-quoted-revision
%% source [LQ/errors §3.2], §5.2 E001
%% entry read
%% transport argv
%% context branch main
%% context rev 4480
%% note conv: the span is the string token.
%% input
USE 'main' MATCH (t) RETURN t
%% error E001 1:5 spec
%% text
error[E001 syntax]: a revision here is written unquoted
 --> <argv>:1:5
  |
1 | USE 'main' MATCH (t) RETURN t
  |     ^^^^^^ write main
%% end

%% case e401-example
%% source [LQ/errors §3.3] example
%% source [LQ/errors §5.5] E401
%% note Statement 1 of a TX matched 0 bindings against EXPECT 1; literal target #89 now has status done, rev 4470,
%% note changed at commit c3e9a1f0083f... (c8 c3e9a1f00) by dev#2 on lane/l5np with message complete L-17.
%% note The help line names the command without back-quotes, as §3.3's example and §5.5's row now both write it (spec
%% note sync 2b, S2B-F-40; F-5 settled).
%% text
error[E401 expect_mismatch]: statement 1 matched 0 bindings, expected 1
  #89 now: status=done rev=4470 (changed at c3e9a1f00 by dev#2 on lane/l5np: "complete L-17")
  nothing was written
  = help: re-read with moirai q show ids=89
%% end

%% case e406-unleased
%% source [LQ/errors §5.5] E406 (unleased, frozen)
%% source [F19 §11.3]
%% source [90 §4.3]
%% note A write that needs a lease and presents none. The frozen one-line text, split at its semicolon.
%% note No detail line and no closing line: a block or call refusal names no statement and does not close with
%% note 'nothing was written' ([LQ/errors §5.5] preamble; spec sync 2b, S2B-F-41; F-6 settled).
%% text
error[E406 role_policy]: this write needs a lease
  = help: an orchestrator presents its session lease with --lease (mint it once per session: moirai claim --role orchestrator --session)
%% end

%% case e407-declared-agent
%% source [LQ/errors §5.5] E407 (declared agent)
%% source [90 §4.1]
%% source [F19 §11.2]
%% note The caller declares agent dev#1 and presents lease L-18, whose holder is dev#2 (one of the two exit-5 texts of [90 §10.1]).
%% note <agent> renders like <holder> (spec gap G-8); no detail line (a call refusal, S2B-F-41).
%% text
error[E407 lease]: declared agent dev#1 differs from lease L-18's holder dev#2
  = help: drop --agent, or pass your own lease
%% end

%% case e411-no-match
%% source [LQ/errors §5.5] E411
%% source [90 §10.1]
%% note A free-form TX from a model with the unknown profile; no named mutation matches; the dry-targets setting is off.
%% text
error[E411 unknown_model_write]: free-form TX is refused for a model with the unknown profile
  no named mutation matches; ask the orchestrator
%% end

