P (
NAME t
P :
NAME task
P {
NAME id
P :
NODE 89
P }
P )
KW WHERE
NAME t
P .
NAME status
P =
STR "in_progress"
KW EXPECT
INT 1
KW SET
NAME t
P .
NAME done
P =
KW TRUE
P }
EOF -
%% end

