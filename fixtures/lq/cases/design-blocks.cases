KW QUERY
NAME pack_rules_unmerged
P (
PARAM role
P :
NAME text
P )
KW SHAPE
NAME node
KW AS
P {
KW USE
REF main
KW CALL
NAME diff
P (
HEAD HEAD
RANGE ...
REF main
P )
KW YIELD
NAME node
P ,
NAME side
KW WHERE
NAME side
KW IN
P [
STR "theirs"
P ,
STR "both"
P ]
KW MATCH
P (
NAME r
P :
NAME rule
P )
KW WHERE
NAME r
P =
NAME node
KW AND
NAME r
P .
NAME status
P =
STR "active"
KW AND
NAME r
P .
NAME criticality
P =
STR "critical"
KW AND
NAME applies_role
P (
NAME r
P ,
PARAM role
P )
KW RETURN
KW DISTINCT
NAME r
KW ORDER
KW BY
NAME r
P .
NAME criticality
P ,
NAME r
P .
NAME authority
P ,
NAME r
P .
NAME id
P }
EOF -
%% end
