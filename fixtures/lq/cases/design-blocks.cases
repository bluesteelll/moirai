P (
NAME f
P :
NAME finding
P )
KW WHERE
KW EXISTS
P {
P (
NAME f
P )
P -
P [
P :
NAME ABOUT
P ]
P ->
P (
NAME s
P )
KW WHERE
NAME s
KW IN
NAME subtree
P (
NODE 130
P )
P }
KW RETURN
NAME f
P .
NAME round
KW AS
NAME round
P ,
KW COUNT
P (
P *
P )
KW AS
NAME raised
P ,
NAME count
P (
KW CASE
KW WHEN
NAME f
P .
NAME status
P =
STR "confirmed"
KW THEN
INT 1
KW END
P )
KW AS
NAME confirmed
P ,
NAME count
P (
KW CASE
KW WHEN
NAME f
P .
NAME status
P =
STR "refuted"
KW THEN
INT 1
KW END
P )
KW AS
NAME refuted
P ,
NAME count
P (
KW CASE
KW WHEN
NAME f
P .
NAME status
P =
STR "confirmed"
KW AND
NAME f
P .
NAME severity
KW IN
P [
STR "blocker"
P ,
STR "important"
P ]
KW THEN
INT 1
KW END
P )
KW AS
NAME blocking
KW ORDER
KW BY
NAME round
EOF -
%% end

%% case q7
%% source [50 §2.9] Q7
%% entry read
%% input
USE lane/l5np
MATCH (f:finding)
WHERE f.created_role IN ['architecture-critic', 'code-reviewer']
  AND EXISTS { (f)-[:ABOUT]->(s) WHERE s IN subtree(#130) }
WITH f.created_role AS critic, count(*) AS raised,
     count(CASE WHEN f.status = 'refuted' THEN 1 END) AS refuted
RETURN critic, raised, refuted, round(100.0 * refuted / raised, 1) AS pct
ORDER BY critic
%% tokens
KW USE
REF lane/l5np
KW MATCH
P (
NAME f
P :
NAME finding
P )
KW WHERE
NAME f
P .
NAME created_role
KW IN
P [
STR "architecture-critic"
P ,
STR "code-reviewer"
P ]
KW AND
KW EXISTS
P {
P (
NAME f
P )
P -
P [
P :
NAME ABOUT
P ]
P ->
P (
NAME s
P )
KW WHERE
NAME s
KW IN
NAME subtree
P (
NODE 130
P )
P }
KW WITH
NAME f
P .
NAME created_role
KW AS
NAME critic
P ,
KW COUNT
P (
P *
P )
KW AS
NAME raised
P ,
NAME count
P (
KW CASE
KW WHEN
NAME f
P .
NAME status
P =
STR "refuted"
KW THEN
INT 1
KW END
P )
KW AS
NAME refuted
KW RETURN
NAME critic
P ,
NAME raised
P ,
NAME refuted
P ,
NAME round
P (
FLOAT 100.0
P *
NAME refuted
P /
NAME raised
P ,
INT 1
P )
KW AS
NAME pct
KW ORDER
KW BY
NAME critic
