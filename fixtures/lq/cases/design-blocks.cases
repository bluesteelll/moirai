%% case s4.3-pack-rules-unmerged
%% source [50 §4.3]
%% entry define
%% note HEAD...main is HEAD, a three-dot range and main. [LQ/lexical §7.2]'s HEAD row, read literally, refuses HEAD
%% note followed by '.', which would make this block (and [LQ/std §5.4]) E003; the fixture asserts the parse [50 §11]
%% note and [LQ/std §1.1] state. Spec finding F-1 (INDEX.md §4).
%% input
DEFINE QUERY pack_rules_unmerged($role: text) SHAPE node AS {
  USE main
  CALL diff(HEAD...main) YIELD node, side
  WHERE side IN ['theirs', 'both']
  MATCH (r:rule)
  WHERE r = node AND r.status = 'active' AND r.criticality = 'critical' AND applies_role(r, $role)
  RETURN DISTINCT r ORDER BY r.criticality, r.authority, r.id
}
%% tokens
