%% case mistake-10
%% source [50 §2.9] mistake 10
%% source [LQ/errors §7] row 10
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: lane commits not on main. Two revisions and a range; a standalone call without YIELD.
%% input
CALL log(main..lane/l5np)
%% tokens
KW CALL
NAME log
P (
REF main
RANGE ..
REF lane/l5np
P )
EOF -
%% sast
(read run
 (query
  [(part _ [] _ (scall "log" [(arg _ (rrange (rref "main") two (rref "lane/l5np")))] none [] _ [] _))]
  []))
%% warnings none
%% notices none
%% outcome runs
%% end
