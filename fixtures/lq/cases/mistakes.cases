%% input
MATCH (p {id: #88})-[:CHILD_OF]->(c:task) RETURN c
%% tokens
KW MATCH
P (
NAME p
P {
NAME id
P :
NODE 88
P }
P )
P -
P [
P :
NAME CHILD_OF
P ]
P ->
P (
NAME c
P :
NAME task
P )
KW RETURN
NAME c
EOF -
%% warnings none
%% outcome runs
%% reads
reads: #88 CHILD_OF c | #88 is a child of c
%% end

%% case mistake-6
%% source [50 §2.9] mistake 6
%% source [LQ/errors §7] row 6
%% source [LQ/errors §5.3] E106 DEPENDS_ON row
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: what #93 depends on. E106 with the DEPENDS_ON row: message 'DEPENDS_ON links doc sections (doc -> doc);
%% note ... are tasks', inline 'between tasks write (d)-[:BLOCKS]->(t) (d finishes before t) or (t)-[:BLOCKED_BY]->(d)'.
%% note The span of a binder error is not fixed by the specification (INDEX.md §4 G-7), so no position is asserted.
%% input
MATCH (t:task)-[:DEPENDS_ON]->(d:task) WHERE t = #93 RETURN d
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
P -
P [
P :
NAME DEPENDS_ON
P ]
P ->
P (
NAME d
P :
NAME task
P )
KW WHERE
NAME t
P =
NODE 93
KW RETURN
NAME d
EOF -
%% error E106 *
%% outcome error
%% end

%% case mistake-7
%% source [50 §2.9] mistake 7
%% source [LQ/errors §7] row 7
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: section dependencies. s1 is an identifier. No diagnostic; the hop is not anchored, so no echo under gated.
%% input
MATCH (s1:doc)-[:DEPENDS_ON]->(s2:doc) RETURN s1, s2
%% tokens
KW MATCH
P (
NAME s1
P :
NAME doc
P )
P -
P [
P :
NAME DEPENDS_ON
P ]
P ->
P (
NAME s2
P :
NAME doc
P )
KW RETURN
NAME s1
P ,
NAME s2
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "s1" ["doc"] [] _) [(estep (epat _ right ["DEPENDS_ON"] _ [] _) (npat "s2" ["doc"] [] _))])]
      _)]
    (return false false [(item (ident "s1") _) (item (ident "s2") _)] [] [] _)
    _)]
  []))
%% warnings none
%% notices none
%% outcome runs
%% reads
%% end

