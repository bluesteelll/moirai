# fixtures/lq/cases/mistakes.cases: the ten mistakes of [50 §2.9] with the frozen outcomes of [LQ/errors §7]
# (WP-22, R-FIX). Each case writes the table's fragment as a whole query and asserts: the parse (S-AST where the
# parse is the point), the outcome (runs, or the first error's code), the warnings the binder raises, and the
# reading-echo lines ([LQ/envelope §4]) under the gated profile ([90 §8.2]; mistakes 4 and 5 are anchored hops on
# same-kind edges and echo under every profile).
# Context for binding: the core schema ([F08]) and a store in which the named nodes exist (#51, #88, #93 tasks;
# #130 a doc) on branch main with lane/l5np. The gt10/ walk-through store has nodes of these kinds under other
# numbers (fixtures/gt10/walkthrough.cases), so a harness that runs these outcomes creates the four ids itself.
# Store-dependent notices (N07 when a result is empty) are stated as notes, not asserted.
# Format: fixtures/lq/INDEX.md §2.

%% case mistake-1
%% source [50 §2.9] mistake 1
%% source [LQ/errors §7] row 1
%% source [50 §3.2] W07
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: open tasks with no blockers. Parses as NOT EXISTS {...}; the hand-derived readiness draws W07.
%% input
MATCH (t:task) WHERE t.status = 'open' AND NOT (t)<-[:BLOCKS]-() RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME status
P =
STR "open"
KW AND
KW NOT
P (
NAME t
P )
P <-
P [
P :
NAME BLOCKS
P ]
P -
P (
P )
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "t" ["task"] [] _) [])]
      (and (cmp = (prop (ident "t") "status") (str "open"))
           (not (exists (subp [(path (npat "t" [] [] _)
                                     [(estep (epat _ left ["BLOCKS"] _ [] _) (npat _ [] [] _))])]
                              _)))))]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% warnings W07
%% outcome runs
%% reads
%% end

%% case mistake-2
%% source [50 §2.9] mistake 2
%% source [LQ/errors §7] row 2
%% source [50 §3.2] W07
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: ready tasks, hand-written. Runs; W07.
%% input
MATCH (t:task) WHERE t.status = 'open' AND NOT EXISTS { MATCH (b)-[:BLOCKS]->(t) WHERE b.status <> 'done' } RETURN t
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
KW WHERE
NAME t
P .
NAME status
P =
STR "open"
KW AND
KW NOT
KW EXISTS
P {
KW MATCH
P (
NAME b
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P (
NAME t
P )
KW WHERE
NAME b
P .
NAME status
P <>
STR "done"
P }
KW RETURN
NAME t
EOF -
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "t" ["task"] [] _) [])]
      (and (cmp = (prop (ident "t") "status") (str "open"))
           (not (exists (subq [(match false _ [(path (npat "b" [] [] _) [(estep (epat _ right ["BLOCKS"] _ [] _) (npat "t" [] [] _))])]
                                      (cmp <> (prop (ident "b") "status") (str "done")))]
                              _)))))]
    (return false false [(item (ident "t") _)] [] [] _)
    _)]
  []))
%% warnings W07
%% outcome runs
%% reads
%% end

%% case mistake-3
%% source [50 §2.9] mistake 3
%% source [LQ/errors §7] row 3
%% source [50 §3.4] item 1
%% source [50 §2.9] Q29
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: blockers per task. Bag counting: one binding per matched BLOCKS edge, as in Cypher. No diagnostic.
%% input
MATCH (t:task)<-[:BLOCKS]-() RETURN t.id, count(*) AS blockers
%% tokens
KW MATCH
P (
NAME t
P :
NAME task
P )
P <-
P [
P :
NAME BLOCKS
P ]
P -
P (
P )
KW RETURN
NAME t
P .
NAME id
P ,
KW COUNT
P (
P *
P )
KW AS
NAME blockers
EOF -
%% warnings none
%% notices none
%% outcome runs
%% reads
%% end

%% case mistake-4
%% source [50 §2.9] mistake 4
%% source [LQ/errors §7] row 4
%% source [LQ/envelope §4]
%% entry read
%% profile gated
%% context schema core
%% context branch main
%% note Intent: what #51 waits on. The echo states the stored reading, the opposite of the intent.
%% note When the result is empty and BLOCKS edges point into #51, the result carries N07 (errors-text.cases n07-reverse-edges).
%% input
MATCH (#51)-[:BLOCKS]->(b) RETURN b
%% tokens
KW MATCH
P (
NODE 51
P )
P -
P [
P :
NAME BLOCKS
P ]
P ->
P (
NAME b
P )
KW RETURN
NAME b
EOF -
%% warnings none
%% outcome runs
%% reads
reads: #51 BLOCKS b | #51 must finish before b starts
%% end

%% case mistake-5
