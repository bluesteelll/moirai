# fixtures/lq/cases/json-ir.cases: the JSON IR of [LQ/json-ir] (WP-22, R-FIX): IR documents as input (the '%% input'
# block is the document; '%% entry' follows its root, [LQ/json-ir §2] item 1), the S-AST each denotes, the output
# form of §8, and the refusals of §5. An IR error is located by the JSON Pointer of the offending value (§5.3):
# '%% error <code> ptr <pointer> spec|conv'; its line and col follow from the pointer and the document text.
# The five documents of [LQ/json-ir §7] are used verbatim.
# Format: fixtures/lq/INDEX.md §2.

%% case ir-s44
%% source [LQ/json-ir §7] the example of [LQ/canonical-ast §4.4]
%% source §8
%% entry read
%% note The output form prints the optional limit as an object: shorthands are used only outside optional fields (§8 rule 4).
%% input
{"t": "read",
 "query": {"t": "query", "parts": [
  {"t": "part",
   "clauses": [
    {"t": "match",
     "patterns": [{"t": "path", "start": {"t": "npat", "var": "t", "labels": ["task"]}}],
     "where": {"t": "and",
               "l": {"t": "cmp", "op": "=", "l": {"t": "prop", "e": {"t": "ident", "name": "t"}, "name": "status"},
                     "r": "open"},
               "r": {"t": "cmp", "op": "<=", "l": {"t": "prop", "e": {"t": "ident", "name": "t"}, "name": "priority"},
                     "r": 1}}}],
   "return": {"t": "return", "items": [{"t": "item", "expr": {"t": "ident", "name": "t"}}],
              "order": [{"t": "sort", "expr": {"t": "prop", "e": {"t": "ident", "name": "t"}, "name": "priority"}}],
              "limit": 5}}]}}
%% sast
(read run
 (query
  [(part _
    [(match false _
      [(path (npat "t" ["task"] [] _) [])]
      (and (cmp = (prop (ident "t") "status") (str "open"))
           (cmp <= (prop (ident "t") "priority") (int 1))))]
    (return false false [(item (ident "t") _)] [] [(sort (prop (ident "t") "priority") asc)] (int 5))
    _)]
  []))
%% json-ir
{"t":"read","query":{"t":"query","parts":[{"t":"part","clauses":[{"t":"match","patterns":[{"t":"path","start":{"t":"npat","var":"t","labels":["task"]}}],"where":{"t":"and","l":{"t":"cmp","op":"=","l":{"t":"prop","e":{"t":"ident","name":"t"},"name":"status"},"r":"open"},"r":{"t":"cmp","op":"<=","l":{"t":"prop","e":{"t":"ident","name":"t"},"name":"priority"},"r":1}}}],"return":{"t":"return","items":[{"t":"item","expr":{"t":"ident","name":"t"}}],"order":[{"t":"sort","expr":{"t":"prop","e":{"t":"ident","name":"t"},"name":"priority"}}],"limit":{"t":"int","v":5}}}]}}
%% end

%% case ir-q21-portable-define
%% source [LQ/json-ir §7] Q21
%% source §8
%% entry define
%% note A pdecl default is an optional field, so the output form writes the int 3 as an object.
%% input
{"t": "define", "name": "stale_blockers",
 "params": [{"t": "pdecl", "name": "scope", "type": {"t": "ptype", "name": "node"},
             "default": {"t": "uid", "hex": "018f3c2e7a117b3c9d5e4c2f1a0b9e09"}},
            {"t": "pdecl", "name": "days", "type": {"t": "ptype", "name": "int"}, "default": 3}],
 "shape": "node",
 "body": {"t": "query", "parts": [{"t": "part",
   "clauses": [{"t": "match",
     "patterns": [{"t": "path", "start": {"t": "npat", "var": "b", "labels": ["task"]},
                   "steps": [{"t": "estep", "edge": {"t": "epat", "dir": "right", "types": ["BLOCKS"]},
                              "node": {"t": "npat", "var": "t", "labels": ["task"]}}]}],
     "where": {"t": "and",
       "l": {"t": "and",
         "l": {"t": "in", "l": {"t": "ident", "name": "t"},
               "r": {"t": "fn", "name": "subtree", "args": [{"t": "arg", "value": {"t": "param", "name": "scope"}}]}},
         "r": {"t": "cmp", "op": "=", "l": {"t": "prop", "e": {"t": "ident", "name": "b"}, "name": "status"},
               "r": "in_progress"}},
       "r": {"t": "cmp", "op": "<", "l": {"t": "prop", "e": {"t": "ident", "name": "b"}, "name": "updated_at"},
             "r": {"t": "arith", "op": "-", "l": {"t": "fn", "name": "now"},
                   "r": {"t": "arith", "op": "*", "l": {"t": "param", "name": "days"}, "r": {"t": "dur", "v": "1d"}}}}}}],
   "return": {"t": "return", "distinct": true, "items": [{"t": "item", "expr": {"t": "ident", "name": "b"}}],
              "order": [{"t": "sort", "expr": {"t": "prop", "e": {"t": "ident", "name": "b"}, "name": "updated_at"}}]}}]}}
%% sast
(define "stale_blockers"
 [(pdecl "scope" (ptype "node" _) false (uid "018f3c2e7a117b3c9d5e4c2f1a0b9e09")) (pdecl "days" (ptype "int" _) false (int 3))]
 "node" _
 (query
  [(part _
    [(match false _
      [(path (npat "b" ["task"] [] _) [(estep (epat _ right ["BLOCKS"] _ [] _) (npat "t" ["task"] [] _))])]
      (and (and (in (ident "t") (fn "subtree" false [(arg _ (param "scope"))]))
                (cmp = (prop (ident "b") "status") (str "in_progress")))
           (cmp < (prop (ident "b") "updated_at")
                (arith - (fn "now" false []) (arith * (param "days") (dur "1d"))))))]
    (return true false [(item (ident "b") _)] [] [(sort (prop (ident "b") "updated_at") asc)] _)
    _)]
  []))
%% json-ir
{"t":"define","name":"stale_blockers","params":[{"t":"pdecl","name":"scope","type":{"t":"ptype","name":"node"},"default":{"t":"uid","hex":"018f3c2e7a117b3c9d5e4c2f1a0b9e09"}},{"t":"pdecl","name":"days","type":{"t":"ptype","name":"int"},"default":{"t":"int","v":3}}],"shape":"node","body":{"t":"query","parts":[{"t":"part","clauses":[{"t":"match","patterns":[{"t":"path","start":{"t":"npat","var":"b","labels":["task"]},"steps":[{"t":"estep","edge":{"t":"epat","dir":"right","types":["BLOCKS"]},"node":{"t":"npat","var":"t","labels":["task"]}}]}],"where":{"t":"and","l":{"t":"and","l":{"t":"in","l":{"t":"ident","name":"t"},"r":{"t":"fn","name":"subtree","args":[{"t":"arg","value":{"t":"param","name":"scope"}}]}},"r":{"t":"cmp","op":"=","l":{"t":"prop","e":{"t":"ident","name":"b"},"name":"status"},"r":"in_progress"}},"r":{"t":"cmp","op":"<","l":{"t":"prop","e":{"t":"ident","name":"b"},"name":"updated_at"},"r":{"t":"arith","op":"-","l":{"t":"fn","name":"now"},"r":{"t":"arith","op":"*","l":{"t":"param","name":"days"},"r":{"t":"dur","v":"1d"}}}}}}],"return":{"t":"return","distinct":true,"items":[{"t":"item","expr":{"t":"ident","name":"b"}}],"order":[{"t":"sort","expr":{"t":"prop","e":{"t":"ident","name":"b"},"name":"updated_at"}}]}}]}}
%% end

%% case ir-q18
%% source [LQ/json-ir §7] Q18
%% source §2 item 2
%% entry write
%% note lq 1 on the root is accepted; the output form of this tree is design-blocks.cases q18's json-ir.
%% input
{"lq": 1, "t": "tx",
 "on": {"t": "rref", "name": "lane/l5np"},
 "key": "wf:r7/dev1/complete-89",
 "lease": "L-18",
 "stmts": [
  {"t": "smatch",
   "patterns": [{"t": "path",
                 "start": {"t": "npat", "var": "t", "labels": ["task"],
                           "props": [{"t": "kv", "key": "id", "value": {"t": "nid", "n": 89}}]}}],
   "where": {"t": "and",
             "l": {"t": "cmp", "op": "=", "l": {"t": "prop", "e": {"t": "ident", "name": "t"}, "name": "status"},
                   "r": "in_progress"},
             "r": {"t": "cmp", "op": "=", "l": {"t": "prop", "e": {"t": "ident", "name": "t"}, "name": "rev"},
                   "r": 4466}},
   "expect": {"t": "expect", "kind": "exact", "a": 1},
   "muts": [{"t": "mset", "assigns": [{"t": "assign", "target": {"t": "ident", "name": "t"}, "prop": "done",
                                       "value": true}]}]}]}
%% sast
(tx (rref "lane/l5np") _ _ "wf:r7/dev1/complete-89" "L-18" _
 [(smatch [(path (npat "t" ["task"] [(kv "id" (nid 89))] _) [])]
   (and (cmp = (prop (ident "t") "status") (str "in_progress"))
        (cmp = (prop (ident "t") "rev") (int 4466)))
   (expect exact 1 _ _)
   [(mset [(assign (ident "t") "done" (bool true))])])]
 false)
%% end

%% case ir-q5
%% source [LQ/json-ir §7] Q5
%% entry read
%% input
{"t": "read",
 "query": {"t": "query", "parts": [
  {"t": "part",
   "clauses": [
    {"t": "match", "patterns": [
     {"t": "path", "start": {"t": "npat", "var": "x", "labels": ["task"]},
      "steps": [
       {"t": "gstep",
        "group": {"t": "group",
                  "path": {"t": "path", "start": {"t": "npat", "var": "a", "labels": ["task"]},
                           "steps": [{"t": "estep", "edge": {"t": "epat", "dir": "right", "types": ["BLOCKS"]},
                                      "node": {"t": "npat", "var": "b"}}]},
                  "where": {"t": "prop", "e": {"t": "ident", "name": "a"}, "name": "unfinished"},
                  "quant": {"t": "quant", "min": 1, "max": 5}},
        "node": {"t": "npat", "props": [{"t": "kv", "key": "id", "value": {"t": "nid", "n": 93}}]}}]}]}],
   "return": {"t": "return", "items": [{"t": "item", "expr": {"t": "ident", "name": "x"}}]}}]}}
%% sast-same-as conformance.cases:quant-group
%% end

%% case ir-q13
%% source [LQ/json-ir §7] Q13
%% entry read
%% input
{"t": "read",
 "query": {"t": "query", "parts": [
  {"t": "part",
   "call": {"t": "scall", "proc": "diff",
            "args": [{"t": "arg", "value": {"t": "rrange", "from": {"t": "rref", "name": "main"}, "op": "three",
                                            "to": {"t": "rref", "name": "lane/l10"}}}],
            "yield": "items",
            "items": [{"t": "yitem", "name": "change"}, {"t": "yitem", "name": "node"}, {"t": "yitem", "name": "side"}],
            "where": {"t": "cmp", "op": "=", "l": {"t": "ident", "name": "side"}, "r": "both"}}}]}}
%% sast-same-as conformance.cases:range-3dot
%% end

%% case ir-shorthands
%% source [LQ/json-ir §3.3]
%% source J-4
%% entry read
%% note A string is str; an integer int (with '-', neg of it); a number with a fraction or exponent a float keeping its text; an array a list.
%% input
{"t":"read","query":{"t":"query","parts":[{"t":"part","return":{"t":"return","items":[{"t":"item","expr":["x", -2, 1.50, 2e3, [1, true, null], {"t": "str", "v": "y"}]}]}}]}}
%% sast
(read run (query [(part _ []
 (return false false
  [(item (list [(str "x") (neg (int 2)) (float "1.50") (float "2e3") (list [(int 1) (bool true) (null)]) (str "y")]) _)]
  [] [] _) _)] []))
%% end

%% case ir-null-literal-in-optional-field
%% source [LQ/json-ir §3.4]
%% entry read
%% note In an optional field null means absent; the NULL literal there is written {"t": "null"}.
%% input
{"t":"read","query":{"t":"query","parts":[{"t":"part","return":{"t":"return","items":[{"t":"item","expr":{"t": "case", "whens": [{"t": "when", "cond": true, "then": 1}], "else": {"t": "null"}}}]}}]}}
%% sast
(read run (query [(part _ [] (return false false [(item (case _ [(when (bool true) (int 1))] (null)) _)] [] [] _) _)] []))
%% end

