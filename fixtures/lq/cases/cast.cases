# fixtures/lq/cases/cast.cases: the canonical AST of [LQ/canonical-ast §5]-§8 (WP-22, R-FIX): C-AST goldens in the
# text form of §4.3 with their binding context (§9), the binary encoding of §6 and the query hash of §7.
# The encoding of s44-quoted is the 174 bytes of [LQ/canonical-ast §6.5], reproduced byte for byte; the other
# encodings are derived from the same tables. Hashes: '%% hash blake3_256 0..<n> first 16 = <hex>' is H of §7.1,
# the first 16 bytes of BLAKE3-256 over the encoding (what a {blake3_256 0..<n>} directive of xtask hex gives).
# Cases with '%% cast-same-as' must produce the identical C-AST, hence the identical encoding and hash.
# Context lines: 'schema core' (the core schema of [F08]); 'node <N> <uid>'; 'commit <seq> <64 hex>';
# 'param <name> <type> <value>'.
# Format: fixtures/lq/INDEX.md §2.

%% case s44-quoted
%% source [LQ/canonical-ast §4.4] first text
%% source §6.5
%% source §7.1
%% entry read
%% context schema core
%% note The C-AST, the 174 bytes and H of [LQ/canonical-ast §4.4] and §6.5; H[0..4] gives the EXPLAIN id q:073f2b4d.
%% input
MATCH (t:task) WHERE t.status = 'open' AND t.priority <= 1 RETURN t ORDER BY t.priority LIMIT 5
%% cast
(QUERY
 (PART _
  (CLAUSES
   [(MATCH false
     [(PATH (NODEP 0 ["task"] [] _) [])]
     (AND (CMP = (PROP (VAR 0) "status") (ENUM "open"))
          (CMP <= (PROP (VAR 0) "priority") (INT 1))))]
   (RETURN false false [(RITEM (VAR 0) _)] [(SORT (PROP (VAR 0) "priority") false)] (INT 5))))
 [])
%% encoding
10 00 00 00 6d 6f 69 72 61 69 2d 6c 71 2d 61 73 74 2d 76 31 01 00 01 02 00 03 01 00 00 00 10 00
01 00 00 00 20 21 01 00 00 00 00 01 00 00 00 04 00 00 00 74 61 73 6b 00 00 00 00 00 00 00 00 00
01 31 33 01 3a 3b 00 00 00 00 06 00 00 00 73 74 61 74 75 73 58 04 00 00 00 6f 70 65 6e 33 04 3a
3b 00 00 00 00 08 00 00 00 70 72 69 6f 72 69 74 79 52 01 00 00 00 00 00 00 00 14 00 00 01 00 00
00 16 3b 00 00 00 00 00 01 00 00 00 18 3a 3b 00 00 00 00 08 00 00 00 70 72 69 6f 72 69 74 79 00
01 52 05 00 00 00 00 00 00 00 00 00 00 00
%% hash blake3_256 0..174 first 16 = 073f2b4d1d0af442d00ad286347b22fb
%% explain-id q:073f2b4d
%% cursor-query-hash 0x42f40a1d4d2b3f07
%% end

%% case s44-bare-words
%% source [LQ/canonical-ast §4.4] second text
%% entry read
%% context schema core
%% note Keyword case, variable names, label case, a bare enum word and 'P1' against priority all canonicalise away.
%% input
match (x:Task) where x.status = open and x.priority <= 'P1' return x order by x.priority asc limit 5
%% cast-same-as s44-quoted
%% end

%% case s44-formatting
%% source [50 §5.3], [LQ/canonical-ast §1.2]
%% entry read
%% context schema core
%% note Comments, line breaks and the explicit ASC do not change the C-AST.
%% input
MATCH (t:task) // open, P0 and P1
WHERE t.status = 'open'
  AND t.priority <= 1 /* stored order */
RETURN t ORDER BY t.priority ASC LIMIT 5
%% cast-same-as s44-quoted
%% end

%% case s44-explain-trail
%% source [LQ/canonical-ast §5.2]
%% entry read
%% context schema core
%% note read.mode and match.mode are removed: the EXPLAIN id is the hash of the query itself (q:073f2b4d).
%% input
EXPLAIN MATCH TRAIL (t:task) WHERE t.status = 'open' AND t.priority <= 1 RETURN t ORDER BY t.priority LIMIT 5
%% cast-same-as s44-quoted
%% end

%% case s44-parameters
%% source [LQ/canonical-ast §5.5] Parameters
%% entry read
%% context schema core
%% context param s text open
%% context param p int 1
%% context param n int 5
%% note Parameter values are substituted with their use-site types: a text value at an enum field is ENUM.
%% input
MATCH (t:task) WHERE t.status = $s AND t.priority <= $p RETURN t ORDER BY t.priority LIMIT $n
%% cast-same-as s44-quoted
%% end

