     [(PATH (NODEP 0 ["task"] [] _) [])]
     (EXISTS (SUBP [(PATH (NODEP 0 [] [] _) [(ESTEP (EDGEP _ right [] _ [] _) (NODEP 1 [] [] _))])] _)))]
   (RETURN false false [(RITEM (VAR 0) _)] [] _)))
 [])
