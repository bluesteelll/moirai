%% context commit 4466 41d7e0b055bb78a370f2eb047e4a54dcc0342ddb0e84b9b0a67f3aff873480ef
%% note Literals the binder coerces to a node or a revision are store-local and are rewritten too.
%% input
DEFINE QUERY q40() AS { MATCH (t {id: 40}) WHERE t.rev = 4466 RETURN t }
%% cast
(DEFINE "q40" [] _ _
 (QUERY
  (PART _
   (CLAUSES
    [(MATCH false [(PATH (NODEP 0 [] [["id" (NODE "018f3c2e7a117b3c9d5e4c2f1a0b9e40")]] _) [])] (CMP = (PROP (VAR 0) "rev") (RCOMMIT "41d7e0b055bb78a370f2eb047e4a54dcc0342ddb0e84b9b0a67f3aff873480ef")))]
    (RETURN false false [(RITEM (VAR 0) _)] [] _)))
  []))
