%% hash blake3_256 0..378 first 16 = 56024d5df84ca25093452efb78b825ea
%% portable
DEFINE QUERY stale_blockers($scope: node = #u:018f3c2e7a117b3c9d5e4c2f1a0b9e09, $days: int = 3) SHAPE node AS {
  MATCH (b:task)-[:BLOCKS]->(t:task)
  WHERE t IN subtree($scope)
    AND b.status = 'in_progress' AND b.updated_at < now() - $days * 1d
  RETURN DISTINCT b ORDER BY b.updated_at
}
%% end

