%% case cursor-query
%% source [LQ/canonical-ast §7.2] cursor query hash
%% source [LQ/envelope §8.1]
%% entry read
%% context schema core
%% note The query of envelope.cases cursor-bytes: H[0..8] read as a little-endian u64 is the cursor's query_hash.
%% input
MATCH (t:task) WHERE t.status = 'open' RETURN t ORDER BY t.priority
%% cast
(QUERY
 (PART _
  (CLAUSES
   [(MATCH false [(PATH (NODEP 0 ["task"] [] _) [])] (CMP = (PROP (VAR 0) "status") (ENUM "open")))]
   (RETURN false false [(RITEM (VAR 0) _)] [(SORT (PROP (VAR 0) "priority") false)] _)))
 [])
