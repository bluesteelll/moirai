%% case imp-maximal-subparts
%% source [F07 §5.3] step 1
%% note F0 80 80 is three maximal subparts (F0 cannot start 80), E2 82 one (a truncated sequence), ED A0 80 three.
%% function N_imp
%% input-hex
61f0808062e2827aeda0800a
%% output-hex
61efbfbdefbfbdefbfbd62efbfbd7aefbfbdefbfbdefbfbd
%% output-text "a\ufffd\ufffd\ufffdb\ufffdz\ufffd\ufffd\ufffd"
%% output-length 24
%% end

%% case imp-nul
%% source [F07 §5.3] step 1
%% note U+0000 becomes U+FFFD.
%% function N_imp
%% input-hex
610062
%% input-text "a\u0000b"
%% output-hex
61efbfbd62
%% output-text "a\ufffdb"
%% output-length 5
%% end

%% case imp-trailer-kept
%% source [F07 §5.3]
%% note N_imp never refuses; the Moirai- rule does not apply.
%% function N_imp
%% input-hex
646f6e650a0a4d6f697261692d5265663a206d61696e0a
%% input-text "done\n\nMoirai-Ref: main\n"
%% output-hex
646f6e650a0a4d6f697261692d5265663a206d61696e
%% output-text "done\n\nMoirai-Ref: main"
%% output-length 22
%% end

%% case imp-cut-at-scalar-boundary
%% source [F07 §5.3] step 3
%% note 65,536 bytes: the cut at 65,535 would split U+00E9, so it falls back to 65,534.
%% function N_imp
%% input-hex
61 * 65534
c3a9
%% output-hex
61 * 65534
%% output-length 65534
%% end

%% case imp-cut-then-trim
