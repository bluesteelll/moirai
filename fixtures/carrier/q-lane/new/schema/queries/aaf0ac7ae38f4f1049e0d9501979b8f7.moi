moirai-query 1
name: open_tasks
lq: 1
params: $scope: node = #u:a0000000000000000000000000000001, $limit: int = 20
shape: table
budget: light
---
DEFINE QUERY open_tasks($scope: node = #u:a0000000000000000000000000000001, $limit: int = 20) SHAPE table BUDGET light AS {
  // only urgent work
  MATCH (t:task)
  WHERE t.status = 'open' AND t.priority <= 'P1' AND t IN subtree($scope)
  RETURN t ORDER BY t.priority LIMIT $limit
}
