moirai-query 1
name: open_tasks
conflict definition class=FieldEdit base="moirai-query 1\nname: open_tasks\nlq: 1\nparams: $scope: node = #u:a0000000000000000000000000000001, $limit: int = 20\nshape: table\nbudget: light\n---\nDEFINE QUERY open_tasks($scope: node = #u:a0000000000000000000000000000001, $limit: int = 20) SHAPE table BUDGET light AS {\n  MATCH (t:task)\n  WHERE t.status = 'open' AND t IN subtree($scope)\n  RETURN t ORDER BY t.priority LIMIT $limit\n}\n" ours="moirai-query 1\nname: open_tasks\nlq: 1\nparams: $scope: node = #u:a0000000000000000000000000000001, $limit: int = 50\nshape: table\nbudget: light\n---\nDEFINE QUERY open_tasks($scope: node = #u:a0000000000000000000000000000001, $limit: int = 50) SHAPE table BUDGET light AS {\n  MATCH (t:task)\n  WHERE t.status = 'open' AND t IN subtree($scope)\n  RETURN t ORDER BY t.priority LIMIT $limit\n}\n" theirs="moirai-query 1\nname: open_tasks\nlq: 1\nparams: $scope: node = #u:a0000000000000000000000000000001, $limit: int = 20\nshape: table\nbudget: light\n---\nDEFINE QUERY open_tasks($scope: node = #u:a0000000000000000000000000000001, $limit: int = 20) SHAPE table BUDGET light AS {\n  // only urgent work\n  MATCH (t:task)\n  WHERE t.status = 'open' AND t.priority <= 'P1' AND t IN subtree($scope)\n  RETURN t ORDER BY t.priority LIMIT $limit\n}\n"
