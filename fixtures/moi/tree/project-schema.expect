schema edge reviews retired=false eclass=historical on_dst=tombstone on_src=retain acyclic=none card=many max_depth=0 uid_derivation=none props=none symmetric=false same_kind=false lq_name=REVIEWS src_kinds=experiment,verdict dst_kinds=any reverse_names=REVIEWED_BY reading="{a} reviews {b}"
schema query joined_titles lq=1 params="$sep: text = '\t', $n: int?" shape="table" budget="light" text="DEFINE QUERY joined_titles($sep: text = '\t', $n: int?) SHAPE table BUDGET light AS {\n  MATCH (t:task)\n  RETURN t.title + $sep + t.status LIMIT $n\n}"
schema query open_tasks lq=1 params="$scope: node = #u:0a000000000000000000000000000001, $limit: int = 20" shape="table" budget="light" text="DEFINE QUERY open_tasks($scope: node = #u:0a000000000000000000000000000001, $limit: int = 20) SHAPE table BUDGET light AS {\n  MATCH (t:task)\n  WHERE t.status = 'open' AND t IN subtree($scope)\n  RETURN t ORDER BY t.priority LIMIT $limit\n}"
