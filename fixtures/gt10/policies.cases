%% case at0
%% from -
%% requires files
%% bind at_root #2
%% source [API §6.5] EnvTree; [API §8.1] Init tree; [API §12.3] LinkFile; [F08 §11.3] (the root node is created with its first file node); [F19 §10.2] ("link the whole file: moirai link <id> --at <path>")
%% script
1 EnvSlots hold=[claude:s1]
2 EnvTree tree=/w/zoo ops=[{op=write,path="notes/design.md",text="The registry holds readers.\n"}]
3 Init seed=65 tree=/w/zoo params=["query.safelist.model.unknown=off"]
4 Claim @agent=orch @env.CLAUDECODE="1" @env.CLAUDE_CODE_SESSION_ID="s1" role=orchestrator session=true
5 Tx @lease=L-1 message="The design review note"
  create as=at_src kind=note fields={title="Design review"}
6 LinkFile @lease=L-1 @tree=/w/zoo node=$at_src specs=["notes/design.md"] => at_file
%% result
exit 0
%% expect
main edge:$at_src:at:$at_file exists yes
main $at_file status present
main $at_src suspect no
%% end

