# fixtures/gt10/policies.cases: every edge policy of the delete-policy matrix, its preconditions, flagged edges,
# tombstones and Undelete (WP-22 gt10/, R-FIX). Format: fixtures/gt10/INDEX.md §2.
# Written from [RULES/delete-policy-matrix] (DO, CD, EA, EF, DP, EG, DS, FL, TB, UD rows), [RULES/state-definition]
# BT and PD rows, [RULES/status-machines] GD-002 and TR-039, [F08 §9.6] (endpoint kinds) and [API §9].
#
# The store "zoo" (seed 64): one small graph per edge kind, all on main; every case deletes one node of it.
#   parent        p_root #1, p_par #2 (under p_root), p_kid #3 (under p_par)
#   blocks        b_a #4 -blocks-> b_x #5 -blocks-> b_b #6; b_y #7 (a replacement); b_d #8 (done) -blocks-> b_e #9;
#                 b_q #10 (an open question) -blocks-> b_f #11
#   gates         g_v #13 (verdict, fail_fixable) -gates-> g_t #12; g_t2 #14 (task), g_v2 #15 (verdict, pass);
#                 g_vp #17 (verdict, pass) -gates-> g_tp #16
#   merge_after   ma_a #18 -merge_after-> ma_b #19 (lanes)
#   runs_in       ri_run #21 -runs_in-> ri_lane #20
#   answers       an_n #23 (note) -answers-> an_q #22 (question, answered)
#   scoped_to     sc_n #26 -scoped_to-> sc_sub #25 (area under sc_top #24); sc_n2 #28 -scoped_to-> sc_lone #27
#   duplicate_of  du_d #30 -duplicate_of-> du_c #29; du_y #31 (canonical replacement)
#   depends_on    dp_s2 #33 -depends_on-> dp_s1 #32 (doc sections)
#   supersedes    su_new #35 -supersedes-> su_old #34 (notes; su_old superseded)
#   derived_from  df_src #37 (note) -> df_dst #36 (task)        cites      ci_src #39 (task) -> ci_dst #38 (note)
#   implements    im_src #41 (task) -> im_dst #40 (decision)   refutes    rf_src #43 -> rf_dst #42 (findings)
#   confirms      cf_src #45 -> cf_dst #44 (findings)          verifies   ve_src #47 (measurement) -> ve_dst #46 (task)
#   addresses     ad_src #49 (task) -> ad_dst #48 (finding)    about      ab_src #51 (finding) -> ab_dst #50 (task)
#   discovered_from dc_src #53 -> dc_dst #52 (tasks)           produced   pr_src #55 (run) -> pr_dst #54 (note)
#   consumed      co_src #57 (run) -> co_dst #56 (note)        contradicts ct_b #59 <-> ct_a #58 (rules, symmetric)
#   mentions      me_src #63 (note, its body names #60) -> me_dst #60 (task)
#   relates       re_b #62 <-> re_a #61 (tasks, symmetric)
# Every case below continues the zoo at command 12; nodes a case creates take #64 onward.
# The "at" rows use their own store (seed 65): at_src #1 (note), at_root #2 (the root node), at_file #3 (file node).

%% case zoo
%% from -
%% source [RULES/delete-policy-matrix] §5 edge-policy; [F08 §9.6]; [API §9.2]
%% script
1 EnvSlots hold=[claude:s1]
2 Init seed=64 params=["query.safelist.model.unknown=off"]
3 Claim @agent=orch @env.CLAUDECODE="1" @env.CLAUDE_CODE_SESSION_ID="s1" role=orchestrator session=true
4 Tx @lease=L-1 message="Zoo: parent"
  create as=p_root kind=task fields={title="Parent: root task"}
  create as=p_par kind=task fields={title="Parent: middle task"} under=$p_root
  create as=p_kid kind=task fields={title="Parent: leaf task"} under=$p_par
5 Tx @lease=L-1 message="Zoo: blocks"
  create as=b_a kind=task fields={title="Blocks: A"}
  create as=b_x kind=task fields={title="Blocks: X"} edges_in=[{kind=blocks,src=$b_a}]
  create as=b_b kind=task fields={title="Blocks: B"} edges_in=[{kind=blocks,src=$b_x}]
  create as=b_y kind=task fields={title="Blocks: replacement Y"}
  create as=b_d kind=task fields={title="Blocks: finished blocker D"}
  create as=b_e kind=task fields={title="Blocks: E"} edges_in=[{kind=blocks,src=$b_d}]
  set target=$b_d fields={status=done}
  create as=b_q kind=question fields={title="Blocks: open question Q"}
  create as=b_f kind=task fields={title="Blocks: F"} edges_in=[{kind=blocks,src=$b_q}]
6 Tx @lease=L-1 message="Zoo: gates"
  create as=g_t kind=task fields={title="Gates: gated task T"}
  create as=g_v kind=verdict fields={title="Gates: failing verdict V",role=architecture-critic,outcome=fail_fixable} edges_out=[{kind=gates,dst=$g_t}]
  create as=g_t2 kind=task fields={title="Gates: replacement task T2"}
  create as=g_v2 kind=verdict fields={title="Gates: replacement verdict V2",role=architecture-critic,outcome=pass}
  create as=g_tp kind=task fields={title="Gates: task TP"}
  create as=g_vp kind=verdict fields={title="Gates: passing verdict VP",role=architecture-critic,outcome=pass} edges_out=[{kind=gates,dst=$g_tp}]
7 Tx @lease=L-1 message="Zoo: merge_after, runs_in, answers"
  create as=ma_a kind=lane fields={title="lane-a"}
  create as=ma_b kind=lane fields={title="lane-b"} edges_in=[{kind=merge_after,src=$ma_a}]
  create as=ri_lane kind=lane fields={title="lane-r"}
  create as=ri_run kind=run fields={title="run-r"} edges_out=[{kind=runs_in,dst=$ri_lane}]
  create as=an_q kind=question fields={title="Answers: question Q"}
  create as=an_n kind=note fields={title="Answers: the answer"} edges_out=[{kind=answers,dst=$an_q}]
  set target=$an_q fields={answer="Yes.",status=answered}
8 Tx @lease=L-1 message="Zoo: scoped_to, duplicate_of, depends_on"
  create as=sc_top kind=area fields={title="Area: top"}
  create as=sc_sub kind=area fields={title="Area: sub"} under=$sc_top
  create as=sc_n kind=note fields={title="Scoped note"} edges_out=[{kind=scoped_to,dst=$sc_sub}]
  create as=sc_lone kind=area fields={title="Area: lone"}
  create as=sc_n2 kind=note fields={title="Scoped note 2"} edges_out=[{kind=scoped_to,dst=$sc_lone}]
  create as=du_c kind=task fields={title="Duplicate: canonical C"}
  create as=du_d kind=task fields={title="Duplicate: D"} edges_out=[{kind=duplicate_of,dst=$du_c}]
  create as=du_y kind=task fields={title="Duplicate: replacement Y"}
  create as=dp_s1 kind=doc fields={title="Section S1",doc_kind=section}
  create as=dp_s2 kind=doc fields={title="Section S2",doc_kind=section} edges_out=[{kind=depends_on,dst=$dp_s1}]
9 Tx @lease=L-1 message="Zoo: historical kinds, part 1"
  create as=su_old kind=note fields={title="Supersedes: old note"}
  create as=su_new kind=note fields={title="Supersedes: new note"}
  link src=$su_new kind=supersedes dst=$su_old
  create as=df_dst kind=task fields={title="Derived-from target"}
  create as=df_src kind=note fields={title="Derived-from source"} edges_out=[{kind=derived_from,dst=$df_dst}]
  create as=ci_dst kind=note fields={title="Cites target"}
  create as=ci_src kind=task fields={title="Cites source"} edges_out=[{kind=cites,dst=$ci_dst}]
  create as=im_dst kind=decision fields={title="Implements target"}
  create as=im_src kind=task fields={title="Implements source"} edges_out=[{kind=implements,dst=$im_dst}]
  create as=rf_dst kind=finding fields={title="Refutes target",failure_scenario="A reader sees a torn slot."}
  create as=rf_src kind=finding fields={title="Refutes source",failure_scenario="None: the slot is written atomically."} edges_out=[{kind=refutes,dst=$rf_dst}]
  create as=cf_dst kind=finding fields={title="Confirms target",failure_scenario="A writer waits forever."}
  create as=cf_src kind=finding fields={title="Confirms source",failure_scenario="Reproduced with two writers."} edges_out=[{kind=confirms,dst=$cf_dst}]
10 Tx @lease=L-1 message="Zoo: historical kinds, part 2"
  create as=ve_dst kind=task fields={title="Verifies target"}
  create as=ve_src kind=measurement fields={title="Verifies source",metric=lock_wait_ms,value=1.5} edges_out=[{kind=verifies,dst=$ve_dst}]
  create as=ad_dst kind=finding fields={title="Addresses target",failure_scenario="The lock leaks on a crash."}
  create as=ad_src kind=task fields={title="Addresses source"} edges_out=[{kind=addresses,dst=$ad_dst}]
  create as=ab_dst kind=task fields={title="About target"}
  create as=ab_src kind=finding fields={title="About source",failure_scenario="The task misses a case."} edges_out=[{kind=about,dst=$ab_dst}]
  create as=dc_dst kind=task fields={title="Discovered-from target"}
  create as=dc_src kind=task fields={title="Discovered-from source"} edges_out=[{kind=discovered_from,dst=$dc_dst}]
  create as=pr_dst kind=note fields={title="Produced target"}
  create as=pr_src kind=run fields={title="run-produced"} edges_out=[{kind=produced,dst=$pr_dst}]
  create as=co_dst kind=note fields={title="Consumed target"}
  create as=co_src kind=run fields={title="run-consumed"} edges_out=[{kind=consumed,dst=$co_dst}]
  create as=ct_a kind=rule fields={title="Contradicts: rule A"}
  create as=ct_b kind=rule fields={title="Contradicts: rule B"} edges_out=[{kind=contradicts,dst=$ct_a}]
  create as=me_dst kind=task fields={title="Mentions target"}
  create as=re_a kind=task fields={title="Relates: A"}
  create as=re_b kind=task fields={title="Relates: B"} edges_out=[{kind=relates,dst=$re_a}]
11 Tx @lease=L-1 message="Zoo: mentions"
  create as=me_src kind=note fields={title="Mentions source"} body="The mentions target is #60."
%% result
exit 0
%% expect
main $p_root container yes
main $p_kid ready yes
main $b_b open_blockers 1
main $b_a is_blocker yes
main $b_d status done
main $b_d resolution completed GR-014
main $b_e open_blockers 0 BT-003
main $b_f open_blockers 1 BT-002
main $g_t gated yes BT-005
main $g_t unblocked yes BT-006
main $g_tp gated no BT-008
main $an_q answered yes PD-026
main $an_q status answered
main $su_old status superseded
main $sc_sub parent $sc_top
main $me_src edges [mentions:$me_dst]
main $df_src suspect no
%% end

# ---- parent ---------------------------------------------------------------------------------------------------

%% case eg-001
%% from zoo
%% source EG-001; DP-006; EA-001; [LQ/errors §5.5] E409
%% script
12 Mutation tx.rm @lease=L-1 id=$p_par reason="gone"
%% result
exit 6
error E409
mentions #3
commit none
%% expect
main $p_par deleted no
%% end

%% case eg-002
