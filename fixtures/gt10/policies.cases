%% case eg-014
%% from zoo
%% source EG-014; CD-004; EF-012; FL-002, FL-003; BT-007; BT-006; [AR §3.3] X5
%% note A deleted failing verdict never silently ungates: its edge is flagged and T's completion stays refused; T's
%% note readiness is unaffected (gates never constrain ready or claim).
%% script
12 Mutation tx.rm @lease=L-1 id=$g_v reason="gone"
%% result
exit 0
ready []
marker deleted $g_v main
%% expect
main edge:$g_v:gates:$g_t flagged yes EG-014
main $g_t gated yes BT-007
main $g_t has_dangling yes FL-003
main $g_t unblocked yes BT-006
main $g_t ready yes FL-002
main $g_v edges [gates:$g_t:flagged]
%% end

