# ---- steps, flagged edges, tombstones, Undelete ------------------------------------------------------------------

%% case ds-003
%% from zoo
%% source DS-003; EG-002; TB-010; [RULES/delete-policy-matrix] OP-8
%% note ds_x #64 with children ds_k1 #65 and ds_k2 #66; ds_k1 blocks ds_k2 and ds_k2 was discovered from ds_k1. Both
%% note edges lie inside the deleted set: the structural one is dropped (not flagged), the historical one is retained.
%% script
12 Tx @lease=L-1 message="A subtree with internal edges"
  create as=ds_x kind=task fields={title="Subtree root"}
  create as=ds_k1 kind=task fields={title="Subtree child 1"} under=$ds_x
  create as=ds_k2 kind=task fields={title="Subtree child 2"} under=$ds_x edges_in=[{kind=blocks,src=$ds_k1}] edges_out=[{kind=discovered_from,dst=$ds_k1}]
13 Mutation tx.rm @lease=L-1 id=$ds_x policy=cascade reason="gone"
%% result
exit 0
marker deleted $ds_x main
marker deleted $ds_k1 main
marker deleted $ds_k2 main
%% expect
main $ds_k1 deleted yes
main $ds_k1 edges [] DS-003
main $ds_k2 edges [discovered_from:$ds_k1] DS-003
%% end

%% case ds-010
%% from zoo
%% finding G-6
%% source DS-010; [F17 §8.2]; [F13 §6.3]; [F19 §12.3] SuspectBudget; [AR §3.4] I42′; [CFG §10] store.suspect-budget
%% note df2 #64 and df3 #65 also derive from df_dst. With a budget of 1, three suspect changes exceed it: affected
%% note omits them and the commit is marked incomplete, but every suspect bit is still set.
%% script
12 ConfigSet @lease=L-1 key=store.suspect-budget value="1"
13 Tx @lease=L-1 message="Two more derivations"
  create as=df2 kind=note fields={title="Derived-from source 2"} edges_out=[{kind=derived_from,dst=$df_dst}]
  create as=df3 kind=note fields={title="Derived-from source 3"} edges_out=[{kind=derived_from,dst=$df_dst}]
14 Mutation tx.rm @lease=L-1 id=$df_dst reason="gone"
%% result
exit 0
hint SuspectBudget
%% expect
main $df_src suspect yes
main $df2 suspect yes
main $df3 suspect yes
* c@14 affected_complete no DS-010
%% end

%% case ds-011
%% from zoo
%% source DS-011
%% script
12 Mutation tx.rm @lease=L-1 @dry=true id=$b_x reason="gone"
%% result
exit 0
dry yes
commit none
markers none
%% expect
main $b_x deleted no
main edge:$b_a:blocks:$b_x exists yes
%% end

%% case fl-001
%% from zoo
%% source FL-001; BT-004; PD-007
%% note fl_p #64 with a child fl_k #65; fl_x #66 blocks fl_p. After fl_x's delete the flagged edge still counts in
%% note fl_p's exogenous blockers, so fl_k, under fl_p, stays blocked.
%% script
12 Tx @lease=L-1 message="A blocked container"
  create as=fl_p kind=task fields={title="Flag: container"}
  create as=fl_k kind=task fields={title="Flag: child"} under=$fl_p
  create as=fl_x kind=task fields={title="Flag: blocker"} edges_out=[{kind=blocks,dst=$fl_p}]
13 Mutation tx.rm @lease=L-1 id=$fl_x reason="gone"
%% result
exit 0
ready []
marker deleted $fl_x main
%% expect
main edge:$fl_x:blocks:$fl_p flagged yes
main $fl_p has_dangling yes
main $fl_k unblocked no FL-001
main $fl_k ready no
%% end

%% case fl-009
%% from eg-005-008
%% source FL-009; UD-001, UD-002, UD-004, UD-006; DM-004; ME-004
%% script
13 Revert @lease=L-1 commit=c@12
%% result
exit 0
outcome landed
marker cleared $b_x main
%% expect
main $b_x deleted no
main edge:$b_x:blocks:$b_b flagged no FL-009
main $b_b has_dangling no
main edge:$b_a:blocks:$b_x exists yes UD-004
main $b_a is_blocker yes
%% end

%% case tb-contents
%% from zoo
%% finding F-15
%% source TB-001 to TB-013; [AR §5b.2] rule 8; [F08 §3.5]
%% note The tombstone keeps its row, kind, title, reason and replacement and drops its fields, body and parent. Its
%% note header enumerations are not asserted: [F08 §3.5] and [API §15.3] keep them, TB-012 does not (finding F-15).
%% script
12 Tx @lease=L-1 message="Give Y an estimate and a body"
  set target=$b_y fields={estimate=3} body="Notes on the replacement."
13 Mutation tx.rm @lease=L-1 id=$b_y reason="gone for good"
%% result
exit 0
marker deleted $b_y main
%% expect
main $b_y deleted yes TB-001
main $b_y title "Blocks: replacement Y" TB-004
main $b_y reason "gone for good" TB-007
main $b_y replaced_by - TB-008
main $b_y field.estimate absent TB-012
main $b_y body - TB-013
main $b_y parent -
main $b_y edges [] TB-011
%% end

%% case ud-notfound
%% from zoo
%% source UD-003 ("else NotFound staged"); DM-004, DM-012; CM-016; [AR §5a.5] revert; [AR §3.4] I34′
%% note X is replaced by Y, then B is deleted; reverting the first delete would restore X -> B to a deleted node, so the
%% note revert stages with NotFound and main is untouched.
%% script
12 Mutation tx.rm @lease=L-1 id=$b_x replaced_by=$b_y reason="first"
13 Mutation tx.rm @lease=L-1 id=$b_b reason="second"
14 Revert @lease=L-1 commit=c@12
%% result
exit 6
outcome staged
violation edge:$b_x:blocks:$b_b NotFound
%% expect
main $b_x deleted yes
main $b_b deleted yes
%% end
