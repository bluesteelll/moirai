%% script
12 Mutation tx.rm @lease=L-1 id=$p_par policy=cascade reason="gone"
%% result
exit 0
ready [$p_root]
marker deleted $p_par main
marker deleted $p_kid main
%% expect
main $p_par deleted yes
main $p_kid deleted yes EF-002
main $p_root children_total 0 EF-004
main $p_root container no
main $p_root unblocked yes
%% end

