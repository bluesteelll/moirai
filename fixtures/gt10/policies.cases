%% case eg-005-008
%% from zoo
%% source EG-005 (in-edge, dropped); EG-008 (out-edge, source unfinished, flagged); EF-005, EF-008; FL-001, FL-003; TB-009; CD-002
%% script
12 Mutation tx.rm @lease=L-1 id=$b_x reason="gone"
%% result
exit 0
ready []
marker deleted $b_x main
%% expect
main edge:$b_a:blocks:$b_x exists no EG-005
main $b_a is_blocker no EF-005
main edge:$b_x:blocks:$b_b flagged yes EG-008
main $b_b has_dangling yes FL-003
main $b_b open_blockers 1 FL-001
main $b_b unblocked no
main $b_x edges [blocks:$b_b:flagged] TB-009
%% end

%% case eg-006-007
