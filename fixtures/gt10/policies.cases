%% script
12 Mutation tx.rm @lease=L-1 id=$b_x replaced_by=$b_y reason="gone"
%% result
exit 0
ready []
marker deleted $b_x main
%% expect
main edge:$b_a:blocks:$b_y exists yes EG-006
main edge:$b_y:blocks:$b_b exists yes EG-007
main edge:$b_y:blocks:$b_b flagged no
main $b_y open_blockers 1 EF-006
main $b_b open_blockers 1 EF-007
main $b_b has_dangling no
main $b_y is_blocker yes
main $b_x edges []
main $b_x replaced_by $b_y
%% end

