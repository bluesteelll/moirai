lane/y $n40 deleted no
lane/y $n40 excluded yes
lane/y $n12 open_blockers 1
lane/y $n12 has_dangling no
%% end

%% case c13s
%% from c13
%% source [AR §5d.3] row 2 "sync applies the same rules with the lane as dst; a flagged blocker keeps #12 out of ready until resolve"; FL-010; MR-044; VA-004
%% note The sync brings the delete and the flagged edge into lane/y; a flagged edge merges as an edge key with its
%% note flag and is exempt from DanglingEdge, so the sync lands and #12 stays out of ready on the lane.
%% script
9 Sync @lease=L-1 lane=lane/y
%% result
exit 0
outcome landed
conflicts none
violations none
markers none
%% expect
lane/y $n40 deleted yes
lane/y edge:$n40:blocks:$n12 flagged yes FL-010
lane/y $n12 has_dangling yes
lane/y $n12 unblocked no
lane/y $n41 parent $n9
lane/y $n40 excluded no
* marker:deleted:$n40:main holders [lane/y,main] ME-002
* ref:lane/y absorbed.main 3
%% end

