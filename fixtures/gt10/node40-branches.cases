# fixtures/gt10/node40-branches.cases: the "node 40" table of [AR §5d.3] across branches (WP-22 gt10/, R-FIX).
# Format: fixtures/gt10/INDEX.md §2. Every case continues the store c0 of node40.cases (labels and numbers there):
#   n9 #1, n12 #2, n40 #3, n41 #4, n52 #5, n203 #6, n17 #7, n77 #8 on main, lane/x and lane/y (forked at c0 = c@5).
# Nodes created here: n205 #9 (c8a), n80 #9 (c14a). Leases: L-1 (orchestrator), L-2 (dev#2, c9p).
# Worked rows restated: NC-009 to NC-021, NX-042 to NX-084 of [RULES/delete-policy-matrix] §11.

%% case c5
%% from node40.cases:c0
%% core yes
%% source NC-009; NX-042 to NX-048; XB-001; [AR §5d.3] row 1 "unaffected (git-like isolation)"; [RULES/state-definition] PD-012, PD-013, PD-018, ME-001
%% note #40 is deleted on lane/x as in c2. main and lane/y still hold it live and still reference it, but the deleted
%% note marker keeps it out of their dispatch and blocking lists; on main #12 is still blocked by the live #40.
%% script
8 Mutation tx.rm @lease=L-1 @branch=lane/x id=$n40 replaced_by=$n52 policy=reparent reason="duplicate of the reader table"
%% result
exit 0
ready [$n41]
marker deleted $n40 lane/x
%% expect
lane/x $n40 deleted yes NX-042
lane/x $n40 hold deleted
lane/x edge:$n52:blocks:$n12 exists yes
lane/x $n41 parent $n9
main $n40 deleted no NX-043
main $n40 deleted_elsewhere yes NX-044
main $n40 excluded yes NX-045
main $n40 is_blocker yes
main $n40 blocking-listed no NX-046
main $n203 blocking-listed yes
main $n12 open_blockers 1 NX-047
main edge:$n40:blocks:$n12 exists yes
lane/y $n40 excluded yes NX-048
* marker:deleted:$n40:lane/x holders [lane/x] ME-001
* marker:deleted:$n40:lane/x active_on [lane/y,main] MF-006
%% end

%% case c6
%% from c5
%% core yes
%% source NC-010; NX-049 to NX-054; XB-002; MR-044; RE-003, RE-005; [RULES/state-definition] OR-005, ME-002
%% note main only read #40, so the delete wins and main's referrers get the same treatment. main has not moved since
%% note c0, so no sync is needed. main now holds the deletion with lane/x's commit as its origin: no new marker.
%% script
9 Merge @lease=L-1 src=lane/x into=main
%% result
exit 0
outcome landed
lca [c@5]
virtual-base no
conflicts none
violations none
markers none
%% expect
main $n40 deleted yes NX-049
main $n40 replaced_by $n52
main $n40 hold deleted
main edge:$n52:blocks:$n12 exists yes NX-050
main edge:$n203:blocks:$n52 exists yes
main $n41 parent $n9 NX-051
main $n17 suspect yes NX-052
main $n40 deleted_elsewhere no NX-053
lane/y $n40 excluded yes NX-054
* marker:deleted:$n40:lane/x holders [lane/x,main] ME-002
* marker:deleted:$n40:lane/x active_on [lane/y]
* ref:main absorbed.lane/x 1 RE-005
%% end

