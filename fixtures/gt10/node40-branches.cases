%% case c7b
%% from c7a
%% core yes
%% finding F-4
%% source NC-012; NX-055 to NX-058; XB-003; MR-042; EP-001; RS-008; PR-001, PR-003; [AR §5a.7] step 0; [F12 §6.3] provisional value
%% note main moved, so the merge first syncs main into lane/x. There #40 is deleted on lane/x's side and modified on
%% note main's: a DeleteVsModify conflict value lands on lane/x with the task's delete-wins provisional state (the
%% note deleting side, ours). The merge into main is then refused while lane/x holds an unresolved conflict. Which of the
%% note two is written when the command is refused is finding F-4; main is untouched either way.
%% script
10 Merge @lease=L-1 src=lane/x into=main
%% result
exit 6
error conflicted_src
%% expect
main $n40 deleted no NX-058
main $n40 priority 0
main $n40 excluded yes
lane/x $n40 conflict.existence DeleteVsModify NX-055
lane/x $n40 deleted yes NX-056
lane/x $n40 hold deleted
%% end

%% case c8a
%% from c5
%% core yes
%% source NC-013; [AR §5d.3] row 1 "main added a structural edge to #40"; [LQ/std §7.2] tx.add
%% note n205 (#9) is a new task on main that blocks #40.
%% script
9 Mutation tx.add @lease=L-1 kind=task title="Reader cache warm-up" blocks=[$n40] => n205
%% result
exit 0
%% expect
main edge:$n205:blocks:$n40 exists yes
main $n40 open_blockers 2
lane/x $n205 exists no
%% end

%% case c8b
%% from c8a
%% core yes
%% finding G-2
%% source NC-014; NX-059 to NX-063; XB-004; VA-004; LS-001; PR-001; [AR §5a.7] steps 0 and 8; [AR §5d.3] row 1 "the whole merge stages"
%% note The sync of step 0 brings #205 and its blocks edge into lane/x, where #40 is deleted: a live, unflagged
%% note structural edge to a tombstone, a DanglingEdge violation. The sync stages on merge/lane/x/from/main, so the
%% note whole merge stages; main and lane/x are untouched. The suggested resolution is repoint:#5 (NX-060).
%% script
10 Merge @lease=L-1 src=lane/x into=main
%% result
exit 6
outcome staged
staging-ref merge/lane/x/from/main
sync.outcome staged
sync.violation edge:$n205:blocks:$n40 DanglingEdge
%% expect
main edge:$n205:blocks:$n40 exists yes NX-062
main $n40 deleted no NX-063
lane/x $n205 exists no
lane/x $n40 deleted yes
* ref:merge/lane/x/from/main exists yes NX-059
* ref:merge/lane/x/from/main kind merge
* ref:merge/lane/x/from/main violations [DanglingEdge:edge:$n205:blocks:$n40] NX-060
* marker:deleted:$n40:lane/x holders [lane/x] VK-003
%% end

%% case c8c
%% from c8b
%% source [AR §5d.3] row 1 "with the suggested resolve … --take repoint:#52"; [F12 §6.5] choice 4 repoint; [F12 §9.3]; [API §4.3] row 7
%% note On the staging ref, the violating edge is re-pointed to #52; lane/x itself is still untouched.
%% script
11 Tx @lease=L-1 @branch=merge/lane/x/from/main message="Re-point the new blocker to #5"
  resolve key=edge:$n205:blocks:$n40 repoint=$n52
%% result
exit 0
%% expect
merge/lane/x/from/main edge:$n205:blocks:$n52 exists yes
merge/lane/x/from/main edge:$n205:blocks:$n40 exists no
lane/x $n205 exists no
%% end

%% case c8d
%% from c8c
%% source [AR §5a.7] step 8 merge --continue; [F12 §9.4]; [API §11.8]
%% note Continuing the staged sync lands it on lane/x and deletes the staging ref.
%% script
12 MergeContinue @lease=L-1 src=main into=lane/x
%% result
exit 0
outcome landed
violations none
%% expect
lane/x $n205 exists yes
lane/x edge:$n205:blocks:$n52 exists yes
lane/x edge:$n205:blocks:$n40 exists no
lane/x $n40 deleted yes
* ref:merge/lane/x/from/main exists no
%% end

%% case c8e
%% from c8d
%% finding F-14
%% source [AR §5a.7] step 0 (after a sync, LCA(src, main) = tip(main)); XB-002; RE-003
%% note The merge is run again (its args repeat command 10's, hence @no_dedupe, finding F-14). lane/x now contains
%% note main's tip, so no sync is needed and the merge lands.
%% script
13 Merge @lease=L-1 @no_dedupe=true src=lane/x into=main
%% result
exit 0
outcome landed
conflicts none
violations none
markers none
%% expect
main $n40 deleted yes
main edge:$n205:blocks:$n52 exists yes
main edge:$n205:blocks:$n40 exists no
main $n52 open_blockers 2
main $n12 open_blockers 1
main $n40 hold deleted
* marker:deleted:$n40:lane/x holders [lane/x,main]
%% end

%% case c9p
%% from node40.cases:c0
%% core yes
%% finding F-2
%% source [AR §5d.3] row 3; [RULES/delete-policy-matrix] NC-015 (c0/lease-L-19); [RULES/state-definition] PD-017; [RULES/role-write-policy] WM-001; [API §10.1]
%% note At c0 #40 is a container with an open blocker, so no claim can lease it (finding F-2). On lane/y the orchestrator
%% note first moves #41 under #9 and drops #203's blocker edge; those keys belong to #41 and #203, so #40 itself is not
%% note modified. Then dev#2 self-claims #40 on lane/y: lease L-2 (the design's L-19), anchor none, TTL 15 min.
%% script
8 Tx @lease=L-1 @branch=lane/y message="Detach #4 and drop the blocker of #3 on lane/y"
  move target=$n41 under=$n9
  unlink src=$n203 kind=blocks dst=$n40
9 Claim @agent=dev#2 @branch=lane/y ids=[$n40]
%% result
exit 0
lease L-2 task=$n40 holder=dev#2 branch=lane/y run=-
%% expect
lane/y $n40 container no
lane/y $n40 open_blockers 0
lane/y $n40 unblocked yes
lane/y $n40 ready@dev#2 yes
* lease:L-2 live yes
* lease:L-2 holder dev#2
* lease:L-2 branch lane/y
main $n40 container yes
%% end

