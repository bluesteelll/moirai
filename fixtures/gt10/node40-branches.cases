%% case c11
%% from node40.cases:c2
%% core yes
%% source NC-020; NX-073 to NX-081; UD-001, UD-003, UD-004, UD-006; DM-004; ME-004; [AR §5d.3] row 6; [AR §5a.5] revert
%% note Reverting the deleting commit writes Undelete with the before-image: #40 is live again, the re-pointed edges
%% note are restored because their targets are live, #41 is its child again, #17 is no longer suspect, and main's
%% note deleted hold ends, so the marker is cleared and the lanes stop excluding #40. #52 loses #203's blocker edge.
%% script
9 Revert @lease=L-1 commit=c@8
%% result
exit 0
outcome landed
conflicts none
violations none
marker cleared $n40 main
%% expect
main $n40 deleted no NX-073
main $n40 status open NX-074
main $n40 parent $n9
main edge:$n40:blocks:$n12 exists yes NX-075
main edge:$n52:blocks:$n12 exists no NX-076
main edge:$n203:blocks:$n40 exists yes NX-077
main edge:$n203:blocks:$n52 exists no NX-078
main $n41 parent $n40 NX-079
main $n17 suspect no NX-080
main $n40 hold none NX-081
main $n52 unblocked yes
lane/x $n40 excluded no
lane/y $n40 excluded no
* c@9 kind revert
%% end

%% case c12
%% from node40.cases:c0
%% core yes
%% requires image
%% source NC-021; NX-082 to NX-084; XB-009; FL-008; [AR §5d.3] row 5; [AR §5b.6] steps 2 and 4; [F14 §11.2] (live -> absent, foreign only)
%% note A person removes #40's node file from the image and commits. The import writes a foreign
%% note Delete{image:file-removed}: #40's blocker edge stays flagged (no replacement), and #41's parent and #203's
%% note blocker edge are left dangling, so the import stages on import/main and main stays where it was.
%% script
8 ImageExport @lease=L-1 dest=/img/node40.git refs=["main"] granularity=commit object_format=sha1 create=true
- ImageEdit repo=/img/node40.git ref=refs/heads/main node=$n40 remove-file author="Pat Example <pat@example.test>"
9 ImageImport @lease=L-1 from=/img/node40.git refs=["main"]
%% result
exit 6
imported ref=main native=0 foreign=1 outcome=staged
%% expect
main $n40 deleted no NX-084
* ref:import/main exists yes NX-082
* ref:import/main violations [DanglingEdge:$n41.parent,DanglingEdge:edge:$n203:blocks:$n40] NX-083
import/main $n40 deleted yes
import/main edge:$n40:blocks:$n12 flagged yes FL-008
%% end

