#!/bin/sh
# commit-msg: refuse AI attribution in a commit message (WP-03; docs/m0/PLAN.md §3.2 item 7; AGENTS.md "Git";
# [60 §3.1] item 7 and the repository rule of [AR]'s binding inputs).
#
# Every commit in this repository is authored by the owner, with no AI co-author and no AI attribution. This hook
# refuses, case-insensitively:
#   1. any Co-authored-by trailer, whoever it names;
#   2. "Generated with" or "Generated by" followed, on the same line, by an AI tool name;
#   3. noreply@anthropic.com and the other AI-vendor addresses listed below (any address at an AI vendor's domain,
#      and the GitHub noreply addresses of AI agents and bots);
#   4. Claude, Anthropic, Codex, OpenAI or Copilot in a trailer or an attribution line;
#   5. the robot emoji U+1F916.
# A bare "Generated with" (no AI tool after it) passes, and so do "Claude Code" and "Codex" as a commit's topic: in
# the subject, or in prose that is neither a trailer nor an attribution line.
#
# Definitions used by rule 4:
#   trailer           a line that git's own parser reports (`git interpret-trailers --parse`); any "Token: value" line
#                     in the last paragraph when the message has more than one paragraph (the first paragraph, the
#                     subject, is never a trailer); and any "Token-by:" or "Token-with:" line wherever it stands.
#   attribution line  a line that starts, after any punctuation or emoji, with an attribution verb (generated,
#                     written, authored, assisted, created, made, produced, drafted, powered, built, prepared, coded,
#                     developed, composed, reviewed, co-authored, co-written) followed by with, by, using, via or
#                     through.
#
# The message is checked as written, comment lines included: with `git commit -m` or `-F`, git keeps lines that start
# with the comment character. Below the scissors line of `git commit -v`, only git's own text is skipped (comment
# lines and the lines of the diff); any other line there is still checked.
#
# This hook is the first of three layers: `cargo xtask gate` (WP-02) re-checks every commit of master..HEAD with the
# same rules, and PR CI (WP-04) re-checks every commit and the pull-request body.
#
# POSIX sh and POSIX awk; runs under Git for Windows' sh, bash and dash. Installed once per clone by the owner:
#   git config core.hooksPath <absolute path of the main worktree>/.githooks
# Tests: sh .githooks/test-hooks.sh

set -u
LC_ALL=C
export LC_ALL

msg=${1:?usage: commit-msg <message-file>}

# Git's own view of the trailers (empty when it finds none).
MOIRAI_GIT_TRAILERS=$(git interpret-trailers --parse <"$msg" 2>/dev/null) || MOIRAI_GIT_TRAILERS=
# The comment prefix: core.commentString or core.commentChar, else "#" ("auto" also falls back to "#").
MOIRAI_COMMENT=$(git config --get core.commentString 2>/dev/null) ||
    MOIRAI_COMMENT=$(git config --get core.commentChar 2>/dev/null) || MOIRAI_COMMENT=
case $MOIRAI_COMMENT in '' | auto) MOIRAI_COMMENT='#' ;; esac
MOIRAI_ROBOT=$(printf '\360\237\244\226')
export MOIRAI_GIT_TRAILERS MOIRAI_COMMENT MOIRAI_ROBOT

awk '
BEGIN {
    robot = ENVIRON["MOIRAI_ROBOT"]
    cc = ENVIRON["MOIRAI_COMMENT"]
    # Word boundaries are written out as [^a-z0-9_] so that every POSIX awk understands them.
    B0 = "(^|[^a-z0-9_])"
    B1 = "([^a-z0-9_]|$)"
    # Rule 1.
    coauth_re = "^[ \t]*co-?authored[-_ ]?by[ \t]*[:=]"
    # Rule 2: "generated with/by", then an AI tool name later on the same line.
    gen_re = "generated[-_ \t]+(with|by)"
    tool_re = B0 "(claude(code)?|anthropic|codex|openai|open ai|chatgpt|gpt[-0-9a-z.]*|copilot|gemini|bard|cursor ai|cursor agent|devin|aider|windsurf|codeium|tabnine|codewhisperer|amazon q|google jules|grok|llama|mistral|deepseek|qwen|sourcegraph cody)" B1
    # Rule 3: addresses at AI vendors, and GitHub noreply addresses of AI agents and bots.
    addr_re = "[a-z0-9._%+-]+@([a-z0-9-]+\\.)*(anthropic\\.com|claude\\.ai|claude\\.com|openai\\.com|chatgpt\\.com|cursor\\.com|cursor\\.sh|anysphere\\.co|codeium\\.com|windsurf\\.com|tabnine\\.com|x\\.ai|mistral\\.ai|deepmind\\.com|deepseek\\.com|cognition\\.ai|devin\\.ai|aider\\.chat)([^a-z0-9.-]|$)"
    bot_re = "(^|[^a-z0-9._%+-])([0-9]+\\+)?(copilot|copilot-swe-agent|claude|claude-code|claude-bot|codex|openai|openai-codex|chatgpt-codex-connector|devin-ai-integration|cursor|cursor-agent|cursoragent|gemini-code-assist|google-labs-jules|aider)(\\[bot\\])?@users\\.noreply\\.github\\.com"
    ghaddr_re = "(^|[^a-z0-9._%+-])copilot@github\\.com"
    # Rule 4.
    names_re = B0 "(claude(code)?|anthropic|codex|openai|open ai|copilot)" B1
    byw_re = "^[ \t]*[a-z0-9][a-z0-9-]*-(by|with)[ \t]*:"
    tok_re = "^[ \t]*[a-z0-9][a-z0-9-]*[ \t]*:"
    url_re = "^[ \t]*[a-z][a-z0-9+.-]*://"
    attr_re = "^[^a-z0-9]*(generated|written|authored|co-authored|coauthored|co-written|assisted|created|made|produced|drafted|powered|built|prepared|coded|developed|composed|reviewed)[ \t]+(with|by|using|via|through)" B1
    n = 0
    cut = 0
    bad = 0
}

# Git text below the scissors line: comment lines and diff lines.
function git_text_after_cut(s,    c) {
    if (s ~ /^[ \t]*$/) return 1
    if (substr(s, 1, length(cutpfx)) == cutpfx) return 1
    c = substr(s, 1, 1)
    if (c == " " || c == "+" || c == "-" || c == "@" || c == "\\") return 1
    if (s ~ /^(diff |index |new file mode |deleted file mode |old mode |new mode |similarity index |dissimilarity index |rename from |rename to |copy from |copy to |Binary files )/) return 1
    return 0
}

function report(where, rule, what, text) {
    printf "commit-msg: refused (rule %d, %s): %s: %s\n", rule, what, where, text
    bad++
}

{
    line = $0
    sub(/\r$/, "", line)
    if (!cut && line ~ /^[^[:alnum:][:space:]]+ -+ >8 -+$/) {
        cut = 1
        cutpfx = substr(line, 1, index(line, " ") - 1)
        next
    }
    if (cut && git_text_after_cut(line)) next
    n++
    L[n] = line
    AFTER[n] = cut
}

END {
    # Paragraphs of the message above the scissors line; comment lines separate paragraphs like blank lines.
    p = 0
    inpara = 0
    for (i = 1; i <= n; i++) {
        PARA[i] = 0
        if (AFTER[i]) continue
        if (L[i] ~ /^[ \t]*$/ || substr(L[i], 1, length(cc)) == cc) { inpara = 0; continue }
        if (!inpara) { p++; inpara = 1 }
        PARA[i] = p
    }
    lastp = p

    for (i = 1; i <= n; i++) {
        t = tolower(L[i])
        where = "line " i
        if (t ~ coauth_re) report(where, 1, "Co-authored-by trailer", L[i])
        if (match(t, gen_re) && substr(t, RSTART + RLENGTH) ~ tool_re) report(where, 2, "Generated with/by an AI tool", L[i])
        if (t ~ addr_re || t ~ bot_re || t ~ ghaddr_re) report(where, 3, "AI-vendor address", L[i])
        trailer = (t ~ byw_re) || (lastp > 1 && PARA[i] == lastp && t ~ tok_re && t !~ url_re)
        if (t ~ names_re) {
            if (trailer) report(where, 4, "AI name in a trailer", L[i])
            else if (t ~ attr_re) report(where, 4, "AI name in an attribution line", L[i])
        }
        if (robot != "" && index(L[i], robot) > 0) report(where, 5, "robot emoji U+1F916", L[i])
    }

    # Git s own trailer parse, for anything the rules above did not already refuse.
    if (!bad) {
        m = split(ENVIRON["MOIRAI_GIT_TRAILERS"], G, "\n")
        for (j = 1; j <= m; j++) {
            t = tolower(G[j])
            if (t ~ coauth_re) report("git trailer", 1, "Co-authored-by trailer", G[j])
            else if (t ~ names_re) report("git trailer", 4, "AI name in a trailer", G[j])
        }
    }

    if (bad) {
        print "commit-msg: the commit was not made. Commits in this repository carry no AI co-author or attribution"
        print "commit-msg: (AGENTS.md, \"Git\"). Remove the lines above and commit again; the rules are in .githooks/commit-msg."
        exit 1
    }
    exit 0
}
' "$msg" >&2
