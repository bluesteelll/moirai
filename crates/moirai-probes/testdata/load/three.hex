# A synthetic load fixture of three samples, written by hand from docs/spec/measurement-protocol.md §9.1 and §9.2
# (cited [MP §x]) for the interop tests of WP-51: `xtask loadrec`'s decoder and recorder (xtask/src/loadrec.rs) and
# moirai-probes' decoder (src/load/fixture.rs) all meet these bytes. Synthetic numbers only, no recorded data.
# Assemble with `cargo xtask hex crates/moirai-probes/testdata/load/three.hex`; xtask's test checks the .bin.
#
# What it exercises: the Process IO counters (#14, #15) missing in every sample, as when typeperf cannot add them;
# a missing processor time in sample 2 and missing disk read bytes and reads in sample 3 (the generator carries the
# previous value); an operation rate below one a second (sample 2, 64 KiB I/O); and a time that is not a whole
# second (2003 ms).
!expect len 1075
!expect blake3_256 5b694ded147913955b1c35ad63b33b75042a70acfe9aba7a65b8a21aa92cc295

00 8C 9A 0D 0A 1A 0A 00        # magic: NUL first, CR LF ^Z LF, no printable byte
{u16 1}                        # version
{u16 18}                       # counter count
{u32 1000}                     # interval, ms

# The name table: per counter of [MP §9.1], its length as one byte, then its name.
{len "\\Processor(_Total)\\% Processor Time" u8} "\\Processor(_Total)\\% Processor Time"    # #0
{len "\\Processor(_Total)\\% Privileged Time" u8} "\\Processor(_Total)\\% Privileged Time"    # #1
{len "\\Processor(_Total)\\% User Time" u8} "\\Processor(_Total)\\% User Time"    # #2
{len "\\PhysicalDisk(_Total)\\Disk Read Bytes/sec" u8} "\\PhysicalDisk(_Total)\\Disk Read Bytes/sec"    # #3
{len "\\PhysicalDisk(_Total)\\Disk Write Bytes/sec" u8} "\\PhysicalDisk(_Total)\\Disk Write Bytes/sec"    # #4
{len "\\PhysicalDisk(_Total)\\Disk Reads/sec" u8} "\\PhysicalDisk(_Total)\\Disk Reads/sec"    # #5
{len "\\PhysicalDisk(_Total)\\Disk Writes/sec" u8} "\\PhysicalDisk(_Total)\\Disk Writes/sec"    # #6
{len "\\PhysicalDisk(_Total)\\Avg. Disk Queue Length" u8} "\\PhysicalDisk(_Total)\\Avg. Disk Queue Length"    # #7
{len "\\Memory\\Available Bytes" u8} "\\Memory\\Available Bytes"    # #8
{len "\\Memory\\Committed Bytes" u8} "\\Memory\\Committed Bytes"    # #9
{len "\\Memory\\Pages/sec" u8} "\\Memory\\Pages/sec"    # #10
{len "\\Paging File(_Total)\\% Usage" u8} "\\Paging File(_Total)\\% Usage"    # #11
{len "\\Process(_Total)\\Private Bytes" u8} "\\Process(_Total)\\Private Bytes"    # #12
{len "\\Process(_Total)\\Working Set" u8} "\\Process(_Total)\\Working Set"    # #13
{len "\\Process(_Total)\\IO Read Bytes/sec" u8} "\\Process(_Total)\\IO Read Bytes/sec"    # #14
{len "\\Process(_Total)\\IO Write Bytes/sec" u8} "\\Process(_Total)\\IO Write Bytes/sec"    # #15
{len "\\Process(_Total)\\Thread Count" u8} "\\Process(_Total)\\Thread Count"    # #16
{len "\\Process(_Total)\\Handle Count" u8} "\\Process(_Total)\\Handle Count"    # #17

# Sample 1: t_ms, then 18 IEEE binary64 values, little-endian; NaN is the quiet NaN 0x7FF8000000000000.
{u64 0}                     # t_ms = 0
{u64 0x4042C00000000000}    # #0  37.5
{u64 0x4028800000000000}    # #1  12.25
{u64 0x4039400000000000}    # #2  25.25
{u64 0x4119000000000000}    # #3  409600
{u64 0x4130000000000000}    # #4  1048576
{u64 0x4059000000000000}    # #5  100
{u64 0x4030000000000000}    # #6  16
{u64 0x3FE0000000000000}    # #7  0.5
{u64 0x41E0000000000000}    # #8  2147483648
{u64 0x4200000000000000}    # #9  8589934592
{u64 0x4008000000000000}    # #10 3
{u64 0x401F000000000000}    # #11 7.75
{u64 0x41F0000000000000}    # #12 4294967296
{u64 0x41E8000000000000}    # #13 3221225472
{u64 0x7FF8000000000000}    # #14 missing
{u64 0x7FF8000000000000}    # #15 missing
{u64 0x4097700000000000}    # #16 1500
{u64 0x40ED4C0000000000}    # #17 60000

# Sample 2: t_ms, then 18 IEEE binary64 values, little-endian; NaN is the quiet NaN 0x7FF8000000000000.
{u64 1000}                  # t_ms = 1000
{u64 0x7FF8000000000000}    # #0  missing
{u64 0x4025000000000000}    # #1  10.5
{u64 0x4034000000000000}    # #2  20
{u64 0x413E848000000000}    # #3  2000000
{u64 0x0000000000000000}    # #4  0
{u64 0x3FE0000000000000}    # #5  0.5
{u64 0x0000000000000000}    # #6  0
{u64 0x3FF4000000000000}    # #7  1.25
{u64 0x41DDCD6500000000}    # #8  2000000000
{u64 0x420004CCB0000000}    # #9  8600000000
{u64 0x0000000000000000}    # #10 0
{u64 0x401F000000000000}    # #11 7.75
{u64 0x41F004CCB0000000}    # #12 4300000000
{u64 0x41E8964020000000}    # #13 3300000000
{u64 0x7FF8000000000000}    # #14 missing
{u64 0x7FF8000000000000}    # #15 missing
{u64 0x4097980000000000}    # #16 1510
{u64 0x40ED4D4000000000}    # #17 60010

# Sample 3: t_ms, then 18 IEEE binary64 values, little-endian; NaN is the quiet NaN 0x7FF8000000000000.
{u64 2003}                  # t_ms = 2003
{u64 0x4056800000000000}    # #0  90
{u64 0x403E000000000000}    # #1  30
{u64 0x404E000000000000}    # #2  60
{u64 0x7FF8000000000000}    # #3  missing
{u64 0x4146E36000000000}    # #4  3000000
{u64 0x7FF8000000000000}    # #5  missing
{u64 0x3FF0000000000000}    # #6  1
{u64 0x4000000000000000}    # #7  2
{u64 0x41DC4FECC0000000}    # #8  1900000000
{u64 0x4200347BB8000000}    # #9  8700000000
{u64 0x4029000000000000}    # #10 12.5
{u64 0x4020000000000000}    # #11 8
{u64 0x41F0642AC0000000}    # #12 4400000000
{u64 0x41E954FC40000000}    # #13 3400000000
{u64 0x7FF8000000000000}    # #14 missing
{u64 0x7FF8000000000000}    # #15 missing
{u64 0x4097C00000000000}    # #16 1520
{u64 0x40ED4E8000000000}    # #17 60020

end:
{xxh3_64 0..end}               # checksum: xxh3-64, seed 0, of every byte before it
